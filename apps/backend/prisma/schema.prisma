generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tblAPIKeyRoleMappings {
  apiKeyID   String     @db.Uuid
  roleID     String     @db.Uuid
  tblAPIKeys tblAPIKeys @relation(fields: [apiKeyID], references: [apiKeyID], onDelete: Cascade, onUpdate: NoAction)
  tblRoles   tblRoles   @relation(fields: [roleID], references: [roleID], onDelete: NoAction, onUpdate: NoAction)

  @@id([apiKeyID, roleID])
}

model tblAPIKeys {
  apiKeyID                                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantID                                            String                  @db.Uuid
  apiKey                                              String                  @db.VarChar
  apiKeyTitle                                         String                  @db.VarChar
  createdAt                                           DateTime                @default(now()) @db.Timestamptz(6)
  isDisabled                                          Boolean
  creatorID                                           String?                 @db.Uuid
  createdByApiKeyID                                   String?                 @db.Uuid
  tblAPIKeyRoleMappings                               tblAPIKeyRoleMappings[]
  tblAPIKeys                                          tblAPIKeys?             @relation("tblAPIKeysTotblAPIKeys", fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblAPIKeysCreatedByApiKeyID")
  other_tblAPIKeys                                    tblAPIKeys[]            @relation("tblAPIKeysTotblAPIKeys")
  tblUsers                                            tblUsers?               @relation(fields: [creatorID], references: [userID], onUpdate: NoAction, map: "fkTblAPIKeysCreatorID")
  tblTenants                                          tblTenants              @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblAPIKeysTenantID")
  tblAppPages                                         tblAppPages[]
  tblCronJobs                                         tblCronJobs[]
  tblDataQueries                                      tblDataQueries[]
  tblDatasources                                      tblDatasources[]
  tblListeners                                        tblListeners[]
  tblTenants_tblTenants_createdByApiKeyIDTotblAPIKeys tblTenants[]            @relation("tblTenants_createdByApiKeyIDTotblAPIKeys")
  tblVaultCredentials                                 tblVaultCredentials[]
  tblWidgets                                          tblWidgets[]
  tblWorkflows                                        tblWorkflows[]

  @@index([createdByApiKeyID], map: "idx_tblAPIKeys_createdByApiKeyID")
}

model tblAuditLogs {
  auditLogID String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userID     String?  @db.Uuid
  tenantID   String?  @db.Uuid
  type       String   @db.VarChar
  subType    String?  @db.VarChar
  success    Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  metadata   Json?
  error      Json?
}

model tblCronJobHistory {
  cronJobHistoryID String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cronJobID        String      @db.Uuid
  status           String      @db.VarChar(50)
  scheduledAt      DateTime?   @db.Timestamptz(6)
  startTime        DateTime?   @db.Timestamptz(6)
  endTime          DateTime?   @db.Timestamptz(6)
  durationMs       Int?
  result           String?
  triggerType      String?     @default("SCHEDULED") @db.VarChar(50)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @db.Timestamptz(6)
  tblCronJobs      tblCronJobs @relation(fields: [cronJobID], references: [cronJobID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblCronJobHistoryCronjobID")
}

model tblCronJobs {
  cronJobID          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cronJobTitle       String              @db.VarChar
  cronJobDescription String?
  cronJobSchedule    String              @db.VarChar
  isDisabled         Boolean             @default(false)
  nextRunAt          DateTime?           @db.Timestamptz(6)
  timeoutSeconds     Int?                @default(300)
  retryAttempts      Int                 @default(0)
  retryDelaySeconds  Int                 @default(60)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @db.Timestamptz(6)
  tenantID           String              @db.Uuid
  workflowID         String?             @db.Uuid
  workflowConfig     Json?
  creatorID          String?             @db.Uuid
  createdByApiKeyID  String?             @db.Uuid
  tblCronJobHistory  tblCronJobHistory[]
  tblAPIKeys         tblAPIKeys?         @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblCronJobsCreatedByApiKeyID")
  tblUsers           tblUsers?           @relation(fields: [creatorID], references: [userID], onUpdate: NoAction, map: "fkTblCronJobsCreatorID")
  tblTenants         tblTenants          @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblCronJobsTenantID")
  tblWorkflows       tblWorkflows?       @relation(fields: [workflowID], references: [workflowID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblCronJobsWorkflowID")

  @@index([createdByApiKeyID], map: "idx_tblCronJobs_createdByApiKeyID")
}

model tblDataQueries {
  dataQueryID           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantID              String          @db.Uuid
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @db.Timestamptz(6)
  disabledAt            DateTime?       @db.Timestamptz(6)
  isDisabled            Boolean?        @default(false)
  dataQueryTitle        String          @default("Untitled") @db.VarChar
  dataQueryDescription  String?         @db.VarChar
  dataQueryOptions      Json?           @db.Json
  runOnLoad             Boolean?
  dataQueryResultSchema Json?           @db.Json
  creatorID             String?         @db.Uuid
  datasourceID          String?         @db.Uuid
  datasourceType        String          @default("postgresql") @db.VarChar
  createdByApiKeyID     String?         @db.Uuid
  tblDatasources        tblDatasources? @relation(fields: [datasourceID], references: [datasourceID], onDelete: NoAction, onUpdate: NoAction, map: "fkDatasourceIDDatasourceID")
  tblAPIKeys            tblAPIKeys?     @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblDataQueriesCreatedByApiKeyID")
  tblUsers              tblUsers?       @relation(fields: [creatorID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblDataQueriesCreatorID")
  tblTenants            tblTenants      @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTenantIDTenantID")

  @@index([createdByApiKeyID], map: "idx_tblDataQueries_createdByApiKeyID")
}

model tblDatasources {
  datasourceID          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datasourceTitle       String           @db.VarChar
  datasourceType        String           @db.VarChar
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @default(now()) @db.Timestamptz(6)
  tenantID              String           @db.Uuid
  creatorID             String?          @db.Uuid
  datasourceOptions     Json
  datasourceTags        String[]         @db.VarChar
  createdByApiKeyID     String?          @db.Uuid
  connectionStatus      String?          @default("inactive") @db.VarChar(32)
  webhookToken          String?          @unique @db.VarChar(128)
  webhookSecret         String?          @db.VarChar(255)
  datasourceDescription String?
  tblDataQueries        tblDataQueries[]
  tblTenants            tblTenants       @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblDatasourceTblTenantsTenantID")
  tblUsers              tblUsers?        @relation(fields: [creatorID], references: [userID], onUpdate: NoAction, map: "fkTblDatasourceTblUsersCreatorID")
  tblAPIKeys            tblAPIKeys?      @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblDatasourcesCreatedByApiKeyID")
  tblListeners          tblListeners[]

  @@index([createdByApiKeyID], map: "idx_tblDatasources_createdByApiKeyID")
}

model tblPermissions {
  permissionID              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissionTitle           String                      @db.VarChar
  permissionDescription     String?                     @db.VarChar
  tblRolePermissionMappings tblRolePermissionMappings[]
}

model tblRolePermissionMappings {
  roleID         String         @db.Uuid
  permissionID   String         @db.Uuid
  tblPermissions tblPermissions @relation(fields: [permissionID], references: [permissionID], onDelete: NoAction, onUpdate: NoAction, map: "fktblRolePermissionMappingsPermission")
  tblRoles       tblRoles       @relation(fields: [roleID], references: [roleID], onDelete: NoAction, onUpdate: NoAction, map: "fktblRolePermissionMappingsRole")

  @@id([roleID, permissionID])
}

model tblRoles {
  roleID                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleTitle                 String                      @db.VarChar
  roleDescription           String?                     @db.VarChar
  tenantID                  String?                     @db.Uuid
  tblAPIKeyRoleMappings     tblAPIKeyRoleMappings[]
  tblRolePermissionMappings tblRolePermissionMappings[]
  tblTenants                tblTenants?                 @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fktblRolesTenantIDTblTenantsTenantID")
  tblUserTenantRoleMappings tblUserTenantRoleMappings[]
}

model tblTenants {
  tenantID                                            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorID                                           String?                       @db.Uuid
  isDisabled                                          Boolean?                      @default(false)
  createdAt                                           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                                           DateTime?                     @default(now()) @db.Timestamptz(6)
  disabledAt                                          DateTime?                     @db.Timestamptz(6)
  disableReason                                       String?                       @db.VarChar
  tenantLogoURL                                       String?                       @db.VarChar
  tenantTitle                                         String                        @db.VarChar
  createdByApiKeyID                                   String?                       @db.Uuid
  tblAPIKeys                                          tblAPIKeys[]
  tblAppPages                                         tblAppPages[]
  tblCronJobs                                         tblCronJobs[]
  tblDataQueries                                      tblDataQueries[]
  tblDatasources                                      tblDatasources[]
  tblListeners                                        tblListeners[]
  tblRoles                                            tblRoles[]
  tblAPIKeys_tblTenants_createdByApiKeyIDTotblAPIKeys tblAPIKeys?                   @relation("tblTenants_createdByApiKeyIDTotblAPIKeys", fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblTenantsCreatedByApiKeyID")
  tblUsers                                            tblUsers?                     @relation(fields: [creatorID], references: [userID], onUpdate: NoAction, map: "fktblTenantstblUsersCreatorID")
  tblUserNotifications                                tblUserNotifications[]
  tblUserTenantConfigMap                              tblUserTenantConfigMap[]
  tblUsersTenantsRelationship                         tblUsersTenantsRelationship[]
  tblVaultCredentials                                 tblVaultCredentials[]
  tblWidgets                                          tblWidgets[]
  tblWorkflowInstances                                tblWorkflowInstances[]
  tblWorkflows                                        tblWorkflows[]

  @@index([createdByApiKeyID], map: "idx_tblTenants_createdByApiKeyID")
}

model tblUserNotifications {
  notificationID String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userID         String      @db.Uuid
  tenantID       String?     @db.Uuid
  title          String      @db.VarChar
  description    String?     @db.VarChar
  actionType     String?     @db.VarChar
  action         String?     @db.VarChar
  actionText     String?     @db.VarChar
  notifierID     String      @db.VarChar
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  tblTenants     tblTenants? @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblUserNotificationsTenantID")
  tblUsers       tblUsers    @relation(fields: [userID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblUserNotificationsUserIDUserID")
}

model tblUserTenantConfigMap {
  userID     String     @db.Uuid
  tenantID   String     @db.Uuid
  config     Json?
  tblTenants tblTenants @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTenantIDTenantID")
  tblUsers   tblUsers   @relation(fields: [userID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "fkUserIDUserID")

  @@id([userID, tenantID])
}

model tblUserTenantRoleMappings {
  userID                      String                      @db.Uuid
  tenantID                    String                      @db.Uuid
  roleID                      String                      @db.Uuid
  tblRoles                    tblRoles                    @relation(fields: [roleID], references: [roleID], onUpdate: NoAction, map: "fkUserTenantRoleRole")
  tblUsersTenantsRelationship tblUsersTenantsRelationship @relation(fields: [tenantID, userID], references: [tenantID, userID], onDelete: Cascade, onUpdate: NoAction, map: "fkUserTenantRoleUserTenant")

  @@id([userID, tenantID, roleID])
}

model tblUsers {
  userID                      String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseID                  String                        @db.VarChar(128)
  phoneNumber                 String?                       @db.VarChar
  firstName                   String?                       @db.VarChar
  lastName                    String?                       @db.VarChar
  address1                    String?                       @db.VarChar
  address2                    String?                       @db.VarChar
  email                       String                        @db.VarChar
  isDisabled                  Boolean?                      @default(false)
  createdAt                   DateTime?                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime?                     @default(now()) @db.Timestamptz(6)
  disabledAt                  DateTime?                     @db.Timestamptz(6)
  disableReason               String?                       @db.VarChar
  lastSeen                    DateTime?                     @db.Timestamptz(6)
  tblAPIKeys                  tblAPIKeys[]
  tblAppPages                 tblAppPages[]
  tblCronJobs                 tblCronJobs[]
  tblDataQueries              tblDataQueries[]
  tblDatasources              tblDatasources[]
  tblListeners                tblListeners[]
  tblTenants                  tblTenants[]
  tblUserNotifications        tblUserNotifications[]
  tblUserTenantConfigMap      tblUserTenantConfigMap[]
  tblUsersTenantsRelationship tblUsersTenantsRelationship[]
  tblVaultCredentials         tblVaultCredentials[]
  tblWidgets                  tblWidgets[]
  tblWorkflows                tblWorkflows[]
}

model tblUsersTenantsRelationship {
  tenantID                  String                      @db.Uuid
  userID                    String                      @db.Uuid
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  role                      String                      @default("MEMBER") @db.VarChar
  tblUserTenantRoleMappings tblUserTenantRoleMappings[]
  tblTenants                tblTenants                  @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTenantIDTenantID")
  tblUsers                  tblUsers                    @relation(fields: [userID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "fkUserIDUserID")

  @@id([tenantID, userID], map: "pktblUsersTenantsRelationship")
  @@unique([tenantID, userID], map: "uniquetblUsersTenantsRelationship")
}

model tblWidgets {
  widgetID          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  widgetTitle       String      @db.VarChar
  widgetDescription String?     @db.VarChar
  widgetType        String      @db.VarChar
  widgetConfig      Json
  createdAt         DateTime?   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime?   @default(now()) @db.Timestamptz(6)
  tenantID          String      @db.Uuid
  creatorID         String?     @db.Uuid
  refreshInterval   Int?
  createdByApiKeyID String?     @db.Uuid
  tblAPIKeys        tblAPIKeys? @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblWidgetsCreatedByApiKeyID")
  tblUsers          tblUsers?   @relation(fields: [creatorID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblWidgetsCreatorID")
  tblTenants        tblTenants  @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "fkTblWidgetsTenantIDTenantID")

  @@index([createdByApiKeyID], map: "idx_tblWidgets_createdByApiKeyID")
}

model tblTenantConfig {
  tenantConfigID String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantID       String    @db.Uuid
  allowedModules String[]  @db.VarChar
  createdAt      DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @db.Timestamptz(6)
}

model tblWorkflowEdge {
  edgeID                                                              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowID                                                          String           @db.Uuid
  upstreamNodeID                                                      String           @db.Uuid
  downstreamNodeID                                                    String           @db.Uuid
  createdAt                                                           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                                                           DateTime         @default(now()) @db.Timestamptz(6)
  sourceHandle                                                        String?          @db.VarChar
  targetHandle                                                        String?          @db.VarChar
  edgeType                                                            String?          @db.VarChar
  edgeConfig                                                          Json?
  tblWorkflowNodes_tblWorkflowEdge_downstreamNodeIDTotblWorkflowNodes tblWorkflowNodes @relation("tblWorkflowEdge_downstreamNodeIDTotblWorkflowNodes", fields: [downstreamNodeID], references: [nodeID], onDelete: Cascade, onUpdate: NoAction, map: "tblWorkflowEdge_downstream_fkey")
  tblWorkflowNodes_tblWorkflowEdge_upstreamNodeIDTotblWorkflowNodes   tblWorkflowNodes @relation("tblWorkflowEdge_upstreamNodeIDTotblWorkflowNodes", fields: [upstreamNodeID], references: [nodeID], onDelete: Cascade, onUpdate: NoAction, map: "tblWorkflowEdge_upstream_fkey")
  tblWorkflows                                                        tblWorkflows     @relation(fields: [workflowID], references: [workflowID], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflowID], map: "idx_tblWorkflowEdge_workflowID")
}

model tblWorkflowInstances {
  instanceID                        String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowID                        String?                             @db.Uuid
  tenantID                          String                              @db.Uuid
  status                            String                              @default("PENDING") @db.VarChar
  version                           Int                                 @default(1)
  startedAt                         DateTime?                           @db.Timestamptz(6)
  completedAt                       DateTime?                           @db.Timestamptz(6)
  createdAt                         DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                         DateTime                            @default(now()) @db.Timestamptz(6)
  isTest                            Boolean                             @default(false)
  tblWorkflowDataCollectionRequests tblWorkflowDataCollectionRequests[]
  tblWorkflowInstanceLogs           tblWorkflowInstanceLogs[]
  tblTenants                        tblTenants                          @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction)
  tblWorkflows                      tblWorkflows?                       @relation(fields: [workflowID], references: [workflowID], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantID, status], map: "idx_tblWorkflowInstances_tenantID_status")
}

model tblWorkflowNodes {
  nodeID                                                             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowID                                                         String            @db.Uuid
  nodeType                                                           String            @db.VarChar
  timeoutSeconds                                                     Int?              @default(300)
  retryLimit                                                         Int?              @default(3)
  createdAt                                                          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                                                          DateTime          @default(now()) @db.Timestamptz(6)
  nodeConfig                                                         Json?
  tblWorkflowEdge_tblWorkflowEdge_downstreamNodeIDTotblWorkflowNodes tblWorkflowEdge[] @relation("tblWorkflowEdge_downstreamNodeIDTotblWorkflowNodes")
  tblWorkflowEdge_tblWorkflowEdge_upstreamNodeIDTotblWorkflowNodes   tblWorkflowEdge[] @relation("tblWorkflowEdge_upstreamNodeIDTotblWorkflowNodes")
  tblWorkflows                                                       tblWorkflows      @relation(fields: [workflowID], references: [workflowID], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflowID], map: "idx_tblWorkflowNodes_workflowID")
}

model tblWorkflows {
  workflowID           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar
  tenantID             String                 @db.Uuid
  creatorID            String?                @db.Uuid
  isDisabled           Boolean?
  disabledAt           DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @db.Timestamptz(6)
  workflowOptions      Json?                  @default("{}")
  createdByApiKeyID    String?                @db.Uuid
  tblCronJobs          tblCronJobs[]
  tblWorkflowEdge      tblWorkflowEdge[]
  tblWorkflowInstances tblWorkflowInstances[]
  tblWorkflowNodes     tblWorkflowNodes[]
  tblAPIKeys           tblAPIKeys?            @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblWorkflowsCreatedByApiKeyID")
  tblUsers             tblUsers?              @relation(fields: [creatorID], references: [userID], onDelete: NoAction, onUpdate: NoAction, map: "tblWorkflowsCreatorID")
  tblTenants           tblTenants             @relation(fields: [tenantID], references: [tenantID], onDelete: NoAction, onUpdate: NoAction, map: "tblWorkflowsTenantID")

  @@index([createdByApiKeyID], map: "idx_tblWorkflows_createdByApiKeyID")
}

model tblWorkflowInstanceLogs {
  logID                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceID           String               @db.Uuid
  nodeID               String?              @db.Uuid
  eventType            String               @db.VarChar
  nodeStatus           String?              @db.VarChar
  outputVariable       String?              @db.VarChar
  payload              Json                 @default("{}")
  errorMessage         String?              @db.VarChar
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  nodeAttempt          Int?
  tblWorkflowInstances tblWorkflowInstances @relation(fields: [instanceID], references: [instanceID], onDelete: Cascade, onUpdate: NoAction, map: "fk_tblWorkflowInstanceLogs_instanceID")

  @@index([instanceID, eventType, nodeID], map: "idx_tblWorkflowInstanceLogs_barrier")
  @@index([instanceID, logID], map: "idx_tblWorkflowInstanceLogs_instance_seq")
}

model tblWorkflowDataCollectionRequests {
  collectionRequestID  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceID           String               @db.Uuid
  nodeID               String               @db.Uuid
  nodeAttempt          Int?
  status               String               @default("PENDING") @db.VarChar(50)
  collectionType       String               @default("form") @db.VarChar(50)
  collectionConfig     Json                 @default("{}")
  submittedData        Json?
  expiresAt            DateTime?            @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @db.Timestamptz(6)
  tblWorkflowInstances tblWorkflowInstances @relation(fields: [instanceID], references: [instanceID], onDelete: Cascade, onUpdate: NoAction)

  @@index([instanceID, status], map: "idx_tblWfDataCollection_instance_status")
  @@index([status, expiresAt], map: "idx_tblWfDataCollection_status_expiry")
}

model tblListenerActions {
  actionID     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listenerID   String       @db.Uuid
  actionType   String       @db.VarChar(30)
  actionConfig Json         @default("{}")
  isEnabled    Boolean      @default(true)
  orderIndex   Int          @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  tblListeners tblListeners @relation(fields: [listenerID], references: [listenerID], onDelete: Cascade, onUpdate: NoAction)

  @@index([listenerID], map: "idx_tblListenerActions_listenerID")
}

model tblListenerEvents {
  eventID      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listenerID   String       @db.Uuid
  tenantID     String       @db.Uuid
  bufferName   String       @db.VarChar(255)
  eventData    Json
  eventMeta    Json?
  receivedAt   DateTime     @default(now()) @db.Timestamptz(6)
  seqNo        BigInt       @default(autoincrement())
  tblListeners tblListeners @relation(fields: [listenerID], references: [listenerID], onDelete: Cascade, onUpdate: NoAction)

  @@index([listenerID, bufferName, seqNo(sort: Desc)], map: "idx_tblListenerEvents_buffer_seq")
  @@index([receivedAt], map: "idx_tblListenerEvents_receivedAt")
  @@index([tenantID], map: "idx_tblListenerEvents_tenantID")
}

model tblListeners {
  listenerID          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantID            String               @db.Uuid
  datasourceID        String               @db.Uuid
  listenerTitle       String               @db.VarChar(255)
  listenerDescription String?
  listenerType        String               @db.VarChar(50)
  listenerConfig      Json                 @default("{}")
  status              String               @default("inactive") @db.VarChar(20)
  lastError           String?
  lastEventAt         DateTime?            @db.Timestamptz(6)
  eventCount          BigInt               @default(0)
  endpointPath        String?              @db.VarChar(255)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @db.Timestamptz(6)
  creatorID           String?              @db.Uuid
  createdByApiKeyID   String?              @db.Uuid
  tblListenerActions  tblListenerActions[]
  tblListenerEvents   tblListenerEvents[]
  tblAPIKeys          tblAPIKeys?          @relation(fields: [createdByApiKeyID], references: [apiKeyID], onUpdate: NoAction, map: "fkTblListenersCreatedByApiKeyID")
  tblUsers            tblUsers?            @relation(fields: [creatorID], references: [userID], onUpdate: NoAction, map: "fkTblListenersCreatorID")
  tblDatasources      tblDatasources       @relation(fields: [datasourceID], references: [datasourceID], onDelete: Cascade, onUpdate: NoAction)
  tblTenants          tblTenants           @relation(fields: [tenantID], references: [tenantID], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantID, endpointPath], map: "uq_tblListeners_tenantID_endpointPath")
  @@index([datasourceID], map: "idx_tblListeners_datasourceID")
  @@index([status], map: "idx_tblListeners_status")
  @@index([tenantID], map: "idx_tblListeners_tenantID")
  @@index([createdByApiKeyID], map: "idx_tblListeners_createdByApiKeyID")
}

