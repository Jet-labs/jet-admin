    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:original": "echo \"Error: no test specified\" && exit 1",
    "start": "export NODE_ENV=production&& nodemon --no-node-snapshot index.js",
