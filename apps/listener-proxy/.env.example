# Listener Proxy — copy to .env for local runs (compose injects these instead).
# Must match the backend's DATABASE_URL / REDIS_URL / VAULT_ENCRYPTION_KEY.

NODE_ENV=development

# App Postgres (same DB as the backend — proxy reloads listener configs from it)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/jet_admin_db

# Redis (required — proxy publishes raw envelopes to the `listener:events` Stream)
REDIS_URL=redis://localhost:6379

# Proxy HTTP (webhooks + /health + control fallback)
LISTENER_PROXY_PORT=8095
# PORT=8095

# Registry identity (multi-proxy sharding)
# Public base URL of THIS node, advertised at registration (informational).
# LISTENER_PROXY_PUBLIC_URL=https://hooks-1.example.com
# Shard weight — higher takes a larger share of listeners.
# LISTENER_PROXY_WEIGHT=100

# Bus tuning (must match backend when customized)
# LISTENER_STREAM=listener:events
# LISTENER_GROUP=listener-workers
# LISTENER_DLQ_STREAM=listener:events:dlq
# LISTENER_CONTROL_CHANNEL=listener:control
# LISTENER_PREFETCH=20
# LISTENER_STREAM_MAXLEN=10000

# Optional shared secret for POST /internal/listeners/reload/:listenerID
# PROXY_CONTROL_TOKEN=

EXPRESS_REQUEST_SIZE_LIMIT=5mb
LOG_LEVEL=info
