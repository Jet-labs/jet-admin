{
  "slug": "inv.document-generation",
  "key": "document-generation",
  "title": "Replenishment Proposals · document generation",
  "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
  "tags": [
    "automation",
    "documents"
  ],
  "options": {
    "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
    "inputDefinitions": [
      {
        "key": "recordID",
        "type": "number",
        "required": false,
        "defaultValue": 1
      }
    ],
    "workflowRunTimeout": 600,
    "workflowTaskTimeout": 60,
    "humanInLoopTimeout": 3600,
    "defaultNodeTimeoutSeconds": 30,
    "defaultRetryLimit": 1,
    "defaultRetryDelaySeconds": 3,
    "nodeDefaults": {
      "javascript": {
        "timeoutSeconds": 10,
        "retryLimit": 1,
        "retryDelaySeconds": 1
      },
      "dataQuery": {
        "timeoutSeconds": 30,
        "retryLimit": 1,
        "retryDelaySeconds": 2
      }
    }
  },
  "nodes": [
    {
      "key": "start",
      "nodeID": "3afebad3-37e0-4f1f-bfbb-345243f7aed5",
      "type": "start",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "start",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "63153cdc-2100-4edc-89b5-8494d20484e2",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "dataQueryID": "7ab4826a-95b7-480e-9417-cfa8b242bbe9",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "buildDocument",
      "nodeID": "4d786adf-c713-4250-a76b-6ac3692604be",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "buildDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nvar html = \"<h1>\" + String(r.proposal_code || \"Record\") + \"</h1><p>Record #\" + String(r.id) + \"</p>\";\nreturn { fileName: \"replenishment_proposals-\" + String(r.id || ctx.recordID) + \".pdf\", fileURL: \"https://files.example.invalid/inventory-replenishment-planner/\" + String(r.id || ctx.recordID) + \".pdf\", mimeType: \"application/pdf\", html: html };\n",
        "outputVariable": "document"
      }
    },
    {
      "key": "linkDocument",
      "nodeID": "04e2ab03-a59c-4a6a-a9ed-043ccc1730c3",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "linkDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "dataQueryID": "7a917435-01b2-4393-a81c-8d412d360a1d",
        "outputVariable": "attachment",
        "inputValues": {
          "entity": "replenishment_proposals",
          "entityID": "{{ ctx.recordID }}",
          "fileName": "{{ ctx.document.fileName }}",
          "fileURL": "{{ ctx.document.fileURL }}",
          "mimeType": "{{ ctx.document.mimeType }}",
          "uploadedBy": "{{ ctx.staffID || 1 }}"
        }
      }
    },
    {
      "key": "notifyDocument",
      "nodeID": "6c256ddd-97fd-4187-a52c-5b78839a5094",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "dataQueryID": "c651fab5-e242-4ec0-97eb-83772b19408a",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.staffID || 1 }}",
          "title": "Replenishment Proposals document ready",
          "body": "Document {{ ctx.document.fileName }} was generated for record #{{ ctx.recordID }}.",
          "category": "success",
          "linkPage": "inv-replenishment_proposals-detail"
        }
      }
    },
    {
      "key": "done",
      "nodeID": "7146f07b-8380-4622-8707-97b15c137e7a",
      "type": "end",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "done",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "outputParameters": [
          {
            "name": "result",
            "sourceVariable": "{{ ctx.document }}"
          }
        ]
      }
    }
  ],
  "edges": [
    {
