        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "delayType": "fixed",
        "delayMs": 250
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "a618fda5-ee48-4ded-acbe-3470b2682ee3",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
