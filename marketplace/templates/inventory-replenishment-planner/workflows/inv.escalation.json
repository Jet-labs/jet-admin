        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "dataQueryID": "7ab4826a-95b7-480e-9417-cfa8b242bbe9",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "readPriority",
      "nodeID": "8095b2a8-4eb9-48a0-89a6-8f6761833506",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "readPriority",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nreturn { id: r.id || ctx.recordID, priority: String(r.status || \"\"), ownerID: Number(r.owner_id || ctx.staffID) };\n",
        "outputVariable": "record"
      }
    },
    {
      "key": "needsEscalation",
      "nodeID": "4b887b14-660c-4974-a16c-9c9d0bd70721",
      "type": "condition",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "needsEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "branches": [
          {
            "id": "escalate",
            "label": "Escalate",
            "condition": "['urgent','high','critical','overdue'].indexOf(String(ctx.record.priority).toLowerCase()) >= 0"
          }
        ],
        "defaultBranch": "normal"
      }
    },
    {
      "key": "notifyEscalation",
      "nodeID": "6ef9105f-0cfa-4e36-9a78-d1c521f4b667",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "dataQueryID": "c651fab5-e242-4ec0-97eb-83772b19408a",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.record.ownerID }}",
          "title": "Replenishment Proposals escalation",
          "body": "Record #{{ ctx.record.id }} was escalated after the response window.",
          "category": "warning",
          "linkPage": "inv-replenishment_proposals-list"
        }
      }
    },
    {
      "key": "done",
