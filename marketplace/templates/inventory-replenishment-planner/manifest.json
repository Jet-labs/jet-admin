  "features": [
    "Seeded, domain-specific data model with audit triggers",
    "Parameterized SQL queries with server-side pagination and CSV export",
    "Role-aware pages and Casbin asset permissions",
    "Workflow automations for intake, approvals, assignments and SLA sweeps",
    "In-app notification center, comments, attachments and saved views",
    "Admin screens for users, roles, audit, operations and data quality"
  ],
  "requiredIntegrations": [
    {
      "key": "erp-rest",
      "title": "ERP inventory REST",
      "requiredFields": [
        "base URL",
        "API token"
      ],
      "mock": "Connector ships disabled with no credentials; seeded stock and purchase orders are the demo source of truth."
    },
    {
      "key": "supplier-webhook",
      "title": "Supplier ASN webhook",
      "requiredFields": [
        "endpoint path",
        "optional signature header"
      ],
      "mock": "POST { \"kind\": \"webhook.received\", \"record_id\": 1 } to the inactive listener to simulate an advance ship notice."
    },
    {
      "key": "slack-alerts",
      "title": "Slack replenishment alerts",
      "requiredFields": [
        "webhook URL",
        "channel"
      ],
      "mock": "Alerts are mirrored into the in-app notification center until a Slack webhook is connected."
    }
  ],
