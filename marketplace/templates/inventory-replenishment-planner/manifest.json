      "edgeCount": 8
    },
    {
      "slug": "inv.approval-chain",
      "title": "Replenishment Proposals · approval chain",
      "description": "Human approval with timeout, rejection and expiry paths. Approved records move to the next stage; every path notifies the owner.",
      "nodeCount": 8,
      "edgeCount": 9
    },
    {
      "slug": "inv.daily-digest",
      "title": "Replenishment Proposals · daily digest",
      "description": "Builds a daily summary and writes a single in-app notification.",
      "nodeCount": 5,
      "edgeCount": 4
    },
    {
      "slug": "inv.data-collection",
      "title": "Replenishment Proposals · supplier/customer follow-up",
      "description": "Suspends for a structured follow-up form, then records the answer as a comment.",
      "nodeCount": 4,
      "edgeCount": 3
    },
    {
      "slug": "inv.error-recovery",
      "title": "Inventory Replenishment Planner · expected failure and recovery",
