[
  {
    "slug": "inv-record-created",
    "key": "record-created",
    "title": "Replenishment Proposals · record created",
    "description": "Inbound record-created event triggers intake triage.",
    "type": "webhook",
    "datasource": "webhook",
    "endpointPath": "inv-record-created",
    "status": "inactive",
    "config": {
      "pathSuffix": "inv-record-created",
      "responseStatusCode": 202,
      "responseBody": "{\"accepted\":true}"
    },
    "actions": [
      {
        "actionType": "transform",
        "actionConfig": {
          "script": "var e = event && event.body ? event.body : event; if (!e || e.kind !== \"record.created\") { return null; } return e;"
        }
      },
      {
        "actionType": "trigger_workflow",
        "actionConfig": {
          "workflowID": "2abc0b6c-d55d-4f50-9484-aa7357b8716d",
          "inputValues": {
            "recordID": "{{ event.record_id }}",
            "staffID": "{{ event.staff_id }}",
            "event": "{{ event }}"
          }
        }
      },
      {
        "actionType": "save_to_buffer",
        "actionConfig": {
          "bufferName": "inv_record-created",
          "maxRecords": 200,
          "maxAgeHours": 72,
          "retentionPolicy": "both"
        }
      }
    ]
  },
