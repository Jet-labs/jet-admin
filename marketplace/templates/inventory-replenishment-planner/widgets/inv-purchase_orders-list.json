[
  {
    "slug": "inv-purchase_orders-list.heading",
    "key": "heading",
    "page": "inv-purchase_orders-list",
    "title": "Purchase Orders",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Purchase Orders\nBrowse, filter and update purchase orders. All edits are audit-logged and soft-deleted records can be restored from the record detail page.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-purchase_orders-list.search",
    "key": "search",
    "page": "inv-purchase_orders-list",
    "title": "Search",
    "type": "search-input",
    "config": {
      "showHeader": false,
      "placeholder": "Search purchase orders...",
      "debounceMs": 350,
      "events": {
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.status",
    "key": "status",
    "page": "inv-purchase_orders-list",
    "title": "Status filter",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "All statuses",
      "defaultValue": "all",
      "options": [
        {
          "label": "All statuses",
          "value": "all"
        },
        {
          "label": "Draft",
          "value": "draft"
        },
        {
          "label": "Sent",
          "value": "sent"
        },
        {
          "label": "Confirmed",
          "value": "confirmed"
        },
        {
          "label": "Partially Received",
          "value": "partially_received"
        },
        {
          "label": "Received",
          "value": "received"
        },
        {
          "label": "Cancelled",
          "value": "cancelled"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.value === 'all' ? '' : event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.range",
    "key": "range",
    "page": "inv-purchase_orders-list",
    "title": "Date range",
    "type": "date-range-picker",
    "config": {
      "showHeader": false,
      "label": "",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.sort",
    "key": "sort",
    "page": "inv-purchase_orders-list",
    "title": "Sort",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Sort by",
      "defaultValue": "po_number",
      "options": [
        {
          "label": "Po Number",
          "value": "po_number"
        },
        {
          "label": "Total Value",
          "value": "total_value"
        },
        {
          "label": "Expected Date",
          "value": "expected_date"
        },
        {
          "label": "Ordered At",
          "value": "ordered_at"
        },
        {
          "label": "Received At",
          "value": "received_at"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.sortBy",
              "value": "{{ event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.selected",
    "key": "selected",
    "page": "inv-purchase_orders-list",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.purchase_orders_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row to inspect it.",
      "isLoading": "{{ (state.queries.purchase_orders_selected || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-purchase_orders-list.table",
    "key": "table",
    "page": "inv-purchase_orders-list",
    "title": "Purchase Orders",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.purchase_orders || {}).data || [])",
      "columns": [
        {
          "key": "po_number",
          "label": "PO number",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "supplier_id",
          "label": "Supplier",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "warehouse_id",
          "label": "Warehouse",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "total_value",
          "label": "Total value",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "expected_date",
          "label": "Expected",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "ordered_at",
          "label": "Ordered",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "received_at",
          "label": "Received",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "buyer_id",
          "label": "Buyer",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "sortable": false,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": true,
        "pageParam": "page",
        "pageSize": 10,
        "totalTemplate": "{{ ((state.queries.purchase_orders || {}).data && (state.queries.purchase_orders || {}).data[0] ? (state.queries.purchase_orders || {}).data[0].total_count : 0) }}"
      },
      "search": {
        "enabled": true,
        "serverSide": true,
        "placeholder": "Search purchase orders..."
      },
      "export": {
        "enabled": true,
        "format": "csv",
        "serverSide": false,
        "buttonLabel": "Export CSV"
      },
      "editing": {
        "enabled": true
      },
      "bulkEdit": {
        "enabled": false,
        "saveLabel": "Save changes"
      },
      "multiSelect": {
        "enabled": true,
        "showSelectAll": true,
        "actions": [
          {
            "label": "Archive selected",
            "actionKey": "archive",
            "variant": "destructive"
          }
        ]
      },
      "emptyText": "No purchase orders found.",
      "emptyHint": "Adjust the filters or create a new record.",
      "isLoading": "{{ (state.queries.purchase_orders || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ],
        "onPageChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": "{{ event.page }}"
            }
          }
        ],
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "po_number": "{{ event.updatedRow.po_number }}",
                "supplier_id": "{{ event.updatedRow.supplier_id }}",
                "warehouse_id": "{{ event.updatedRow.warehouse_id }}",
                "status": "{{ event.updatedRow.status }}",
                "total_value": "{{ event.updatedRow.total_value }}",
                "expected_date": "{{ event.updatedRow.expected_date }}",
                "ordered_at": "{{ event.updatedRow.ordered_at }}",
                "received_at": "{{ event.updatedRow.received_at }}",
                "buyer_id": "{{ event.updatedRow.buyer_id }}",
                "notes": "{{ event.updatedRow.notes }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ],
        "onBulkAction": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_delete",
              "inputValues": {
                "ids": "{{ event.selectedRows.map(function (r) { return r.id; }) }}"
              },
              "successToast": "Records archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.actions",
    "key": "actions",
    "page": "inv-purchase_orders-list",
    "title": "Selected record actions",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record actions",
      "dataTemplate": "{{ (((state.queries.purchase_orders_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row, then use the buttons below."
    }
  },
  {
    "slug": "inv-purchase_orders-list.archive",
    "key": "archive",
    "page": "inv-purchase_orders-list",
    "title": "Archive selected",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive selected",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_delete",
              "inputValues": {
                "ids": "{{ [state.variables.selectedID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.advance",
    "key": "advance",
    "page": "inv-purchase_orders-list",
    "title": "Advance status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Advance status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_status",
              "inputValues": {
                "id": "{{ state.variables.selectedID }}",
                "status": "{{ \"sent\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.explain",
    "key": "explain",
    "page": "inv-purchase_orders-list",
    "title": "List notes",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "Rows are loaded server-side. Use the table toolbar to search, sort and export the current view. Inline edits and bulk actions run the template's parameterized update queries and write to the audit log.",
      "format": "plain"
    }
  },
  {
    "slug": "inv-purchase_orders-list.views",
    "key": "views",
    "page": "inv-purchase_orders-list",
    "title": "Saved views",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.purchase_orders_views || {}).data || [])",
      "columns": [
        {
          "key": "label",
          "label": "View",
          "type": "text",
          "sortable": false
        },
        {
          "key": "config_key",
          "label": "Key",
          "type": "text",
          "sortable": false
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false,
        "placeholder": "Filter saved views"
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No saved views yet.",
      "isLoading": "{{ (state.queries.purchase_orders_views || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.row.config_value.search || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.row.config_value.status || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-list.saveView",
    "key": "saveView",
    "page": "inv-purchase_orders-list",
    "title": "Save current view",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Save current view",
      "submitLabel": "Save view",
      "fields": [
        {
          "key": "name",
          "label": "View name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. My open purchase orders"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_view_create",
              "inputValues": {
                "configKey": "{{ \"saved_view.inv-purchase_orders-list.\" + String(event.formData.name || \"view\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\") }}",
                "value": "{{ ({ search: state.variables.search, status: state.variables.status, page: 1 }) }}",
                "label": "{{ event.formData.name }}"
              },
              "successToast": "View saved",
              "errorToast": "Could not save view"
            }
          }
        ]
      }
    }
  }
]
