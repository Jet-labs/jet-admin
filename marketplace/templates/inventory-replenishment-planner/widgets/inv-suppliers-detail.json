[
  {
    "slug": "inv-suppliers-detail.heading",
    "key": "heading",
    "page": "inv-suppliers-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Supplier detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-suppliers-detail.status",
    "key": "status",
    "page": "inv-suppliers-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ ((((state.queries.suppliers_detail || {}).data || [])[0] || {}).status) }}",
      "variant": "default"
    }
  },
  {
    "slug": "inv-suppliers-detail.statusForm",
    "key": "statusForm",
    "page": "inv-suppliers-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "active",
      "options": [
        {
          "label": "Active",
          "value": "active"
        },
        {
          "label": "On Hold",
          "value": "on_hold"
        },
        {
          "label": "Inactive",
          "value": "inactive"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-detail.statusButton",
    "key": "statusButton",
    "page": "inv-suppliers-detail",
    "title": "Apply status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Apply status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_status",
              "inputValues": {
                "id": "{{ state.variables.recordID }}",
                "status": "{{ (state.widgets[\"widget_bb24cb38-4cc0-42e5-9ab8-243774234c02_1\"] || {}).value || \"active\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-detail.delete",
    "key": "delete",
    "page": "inv-suppliers-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-detail.restore",
    "key": "restore",
    "page": "inv-suppliers-detail",
    "title": "Restore",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Restore record",
      "variant": "outline",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_restore",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record restored",
              "errorToast": "Restore failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-detail.tabs",
    "key": "tabs",
    "page": "inv-suppliers-detail",
    "title": "Record sections",
    "type": "tabs",
    "config": {
      "showHeader": false,
      "tabs": [
        {
          "label": "Overview",
          "value": "overview"
        },
        {
          "label": "Comments",
          "value": "comments"
        },
        {
          "label": "Attachments",
          "value": "attachments"
        },
        {
          "label": "Activity",
          "value": "activity"
        }
      ],
      "defaultTab": "overview",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "{{ event.value }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-detail.record",
    "key": "record",
    "page": "inv-suppliers-detail",
    "title": "Record fields",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record fields",
      "dataTemplate": "{{ (((state.queries.suppliers_detail || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "emptyText": "Record not found.",
      "isLoading": "{{ (state.queries.suppliers_detail || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-suppliers-detail.editTable",
    "key": "editTable",
    "page": "inv-suppliers-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.suppliers_detail || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Supplier",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "code",
          "label": "Code",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "contact_name",
          "label": "Contact",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "email",
          "label": "Email",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "lead_time_days",
          "label": "Lead time (days)",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "min_order_value",
          "label": "Minimum order",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "reliability_score",
          "label": "Reliability",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "payment_terms",
          "label": "Payment terms",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "country",
          "label": "Country",
          "sortable": true,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.suppliers_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "name": "{{ event.updatedRow.name }}",
                "code": "{{ event.updatedRow.code }}",
                "status": "{{ event.updatedRow.status }}",
                "contact_name": "{{ event.updatedRow.contact_name }}",
                "email": "{{ event.updatedRow.email }}",
                "phone": "{{ event.updatedRow.phone }}",
                "lead_time_days": "{{ event.updatedRow.lead_time_days }}",
                "min_order_value": "{{ event.updatedRow.min_order_value }}",
                "reliability_score": "{{ event.updatedRow.reliability_score }}",
                "payment_terms": "{{ event.updatedRow.payment_terms }}",
                "country": "{{ event.updatedRow.country }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
