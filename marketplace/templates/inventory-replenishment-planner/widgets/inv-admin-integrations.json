[
  {
    "slug": "inv-admin-integrations.heading",
    "key": "heading",
    "page": "inv-admin-integrations",
    "title": "Integration health",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Integration health\nThe packaged REST connector is a mock and intentionally unreachable until reconnected. Raw webhook events are read from the platform listener event store, tenant-scoped.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-admin-integrations.ping",
    "key": "ping",
    "page": "inv-admin-integrations",
    "title": "Probe integration",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Run health probe",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "ping",
              "inputValues": {},
              "successToast": "Probe completed",
              "errorToast": "Probe failed (expected for the mock)"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-admin-integrations.result",
    "key": "result",
    "page": "inv-admin-integrations",
    "title": "Probe result",
    "type": "json-viewer",
    "config": {
      "showHeader": true,
      "label": "Probe result",
      "dataTemplate": "{{ (state.queries.ping || {}).data || null }}",
      "isLoading": "{{ (state.queries.ping || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-admin-integrations.ops",
    "key": "ops",
    "page": "inv-admin-integrations",
    "title": "Operations events",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.ops || {}).data || [])",
      "columns": [
        {
          "key": "kind",
          "label": "Kind",
          "type": "badge"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "text"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "badge"
        },
        {
          "key": "severity",
          "label": "Severity",
          "type": "badge"
        },
        {
          "key": "created_at",
          "label": "When",
          "type": "date"
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No integration events.",
      "isLoading": "{{ (state.queries.ops || {}).isLoading || false }}"
    }
  }
]
