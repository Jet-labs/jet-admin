[
  {
    "slug": "inv-suppliers-list.heading",
    "key": "heading",
    "page": "inv-suppliers-list",
    "title": "Suppliers",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Suppliers\nBrowse, filter and update suppliers. All edits are audit-logged and soft-deleted records can be restored from the record detail page.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-suppliers-list.search",
    "key": "search",
    "page": "inv-suppliers-list",
    "title": "Search",
    "type": "search-input",
    "config": {
      "showHeader": false,
      "placeholder": "Search suppliers...",
      "debounceMs": 350,
      "events": {
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.status",
    "key": "status",
    "page": "inv-suppliers-list",
    "title": "Status filter",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "All statuses",
      "defaultValue": "all",
      "options": [
        {
          "label": "All statuses",
          "value": "all"
        },
        {
          "label": "Active",
          "value": "active"
        },
        {
          "label": "On Hold",
          "value": "on_hold"
        },
        {
          "label": "Inactive",
          "value": "inactive"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.value === 'all' ? '' : event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.range",
    "key": "range",
    "page": "inv-suppliers-list",
    "title": "Date range",
    "type": "date-range-picker",
    "config": {
      "showHeader": false,
      "label": "",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.sort",
    "key": "sort",
    "page": "inv-suppliers-list",
    "title": "Sort",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Sort by",
      "defaultValue": "name",
      "options": [
        {
          "label": "Name",
          "value": "name"
        },
        {
          "label": "Code",
          "value": "code"
        },
        {
          "label": "Contact Name",
          "value": "contact_name"
        },
        {
          "label": "Lead Time Days",
          "value": "lead_time_days"
        },
        {
          "label": "Min Order Value",
          "value": "min_order_value"
        },
        {
          "label": "Reliability Score",
          "value": "reliability_score"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.sortBy",
              "value": "{{ event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.selected",
    "key": "selected",
    "page": "inv-suppliers-list",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.suppliers_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row to inspect it.",
      "isLoading": "{{ (state.queries.suppliers_selected || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-suppliers-list.table",
    "key": "table",
    "page": "inv-suppliers-list",
    "title": "Suppliers",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.suppliers || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Supplier",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "code",
          "label": "Code",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "contact_name",
          "label": "Contact",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "email",
          "label": "Email",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "lead_time_days",
          "label": "Lead time (days)",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "min_order_value",
          "label": "Minimum order",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "reliability_score",
          "label": "Reliability",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "payment_terms",
          "label": "Payment terms",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "country",
          "label": "Country",
          "sortable": true,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": true,
        "pageParam": "page",
        "pageSize": 10,
        "totalTemplate": "{{ ((state.queries.suppliers || {}).data && (state.queries.suppliers || {}).data[0] ? (state.queries.suppliers || {}).data[0].total_count : 0) }}"
      },
      "search": {
        "enabled": true,
        "serverSide": true,
        "placeholder": "Search suppliers..."
      },
      "export": {
        "enabled": true,
        "format": "csv",
        "serverSide": false,
        "buttonLabel": "Export CSV"
      },
      "editing": {
        "enabled": true
      },
      "bulkEdit": {
        "enabled": false,
        "saveLabel": "Save changes"
      },
      "multiSelect": {
        "enabled": true,
        "showSelectAll": true,
        "actions": [
          {
            "label": "Archive selected",
            "actionKey": "archive",
            "variant": "destructive"
          }
        ]
      },
      "emptyText": "No suppliers found.",
      "emptyHint": "Adjust the filters or create a new record.",
      "isLoading": "{{ (state.queries.suppliers || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ],
        "onPageChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": "{{ event.page }}"
            }
          }
        ],
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "name": "{{ event.updatedRow.name }}",
                "code": "{{ event.updatedRow.code }}",
                "status": "{{ event.updatedRow.status }}",
                "contact_name": "{{ event.updatedRow.contact_name }}",
                "email": "{{ event.updatedRow.email }}",
                "phone": "{{ event.updatedRow.phone }}",
                "lead_time_days": "{{ event.updatedRow.lead_time_days }}",
                "min_order_value": "{{ event.updatedRow.min_order_value }}",
                "reliability_score": "{{ event.updatedRow.reliability_score }}",
                "payment_terms": "{{ event.updatedRow.payment_terms }}",
                "country": "{{ event.updatedRow.country }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ],
        "onBulkAction": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_delete",
              "inputValues": {
                "ids": "{{ event.selectedRows.map(function (r) { return r.id; }) }}"
              },
              "successToast": "Records archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.actions",
    "key": "actions",
    "page": "inv-suppliers-list",
    "title": "Selected record actions",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record actions",
      "dataTemplate": "{{ (((state.queries.suppliers_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row, then use the buttons below."
    }
  },
  {
    "slug": "inv-suppliers-list.archive",
    "key": "archive",
    "page": "inv-suppliers-list",
    "title": "Archive selected",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive selected",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_delete",
              "inputValues": {
                "ids": "{{ [state.variables.selectedID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.advance",
    "key": "advance",
    "page": "inv-suppliers-list",
    "title": "Advance status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Advance status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_status",
              "inputValues": {
                "id": "{{ state.variables.selectedID }}",
                "status": "{{ \"on_hold\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.explain",
    "key": "explain",
    "page": "inv-suppliers-list",
    "title": "List notes",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "Rows are loaded server-side. Use the table toolbar to search, sort and export the current view. Inline edits and bulk actions run the template's parameterized update queries and write to the audit log.",
      "format": "plain"
    }
  },
  {
    "slug": "inv-suppliers-list.views",
    "key": "views",
    "page": "inv-suppliers-list",
    "title": "Saved views",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.suppliers_views || {}).data || [])",
      "columns": [
        {
          "key": "label",
          "label": "View",
          "type": "text",
          "sortable": false
        },
        {
          "key": "config_key",
          "label": "Key",
          "type": "text",
          "sortable": false
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false,
        "placeholder": "Filter saved views"
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No saved views yet.",
      "isLoading": "{{ (state.queries.suppliers_views || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.row.config_value.search || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.row.config_value.status || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-suppliers-list.saveView",
    "key": "saveView",
    "page": "inv-suppliers-list",
    "title": "Save current view",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Save current view",
      "submitLabel": "Save view",
      "fields": [
        {
          "key": "name",
          "label": "View name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. My open suppliers"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_view_create",
              "inputValues": {
                "configKey": "{{ \"saved_view.inv-suppliers-list.\" + String(event.formData.name || \"view\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\") }}",
                "value": "{{ ({ search: state.variables.search, status: state.variables.status, page: 1 }) }}",
                "label": "{{ event.formData.name }}"
              },
              "successToast": "View saved",
              "errorToast": "Could not save view"
            }
          }
        ]
      }
    }
  }
]
