  {
    "slug": "inv-replenishment_proposals-calendar.calendar",
    "key": "calendar",
    "page": "inv-replenishment_proposals-calendar",
    "title": "Calendar",
    "type": "calendar",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.replenishment_proposals || {}).data || [])",
      "dateKey": "needed_by_date",
      "titleKey": "proposal_code",
      "subtitleKey": "owner_id",
      "groupKey": "status",
      "emptyText": "No dated records.",
