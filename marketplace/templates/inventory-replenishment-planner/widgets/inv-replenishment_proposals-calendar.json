      "events": {
        "onEventSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.event.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-calendar.selected",
    "key": "selected",
    "page": "inv-replenishment_proposals-calendar",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.replenishment_proposals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
