[
  {
    "slug": "inv-replenishment_proposals-calendar.heading",
    "key": "heading",
    "page": "inv-replenishment_proposals-calendar",
    "title": "Replenishment Proposals calendar",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Replenishment Proposals calendar\nMonth view keyed on **needed by date**. Select an event to inspect the record.",
