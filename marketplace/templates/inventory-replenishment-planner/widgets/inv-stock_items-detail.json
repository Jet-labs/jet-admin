  {
    "slug": "inv-stock_items-detail.attachmentForm",
    "key": "attachmentForm",
    "page": "inv-stock_items-detail",
    "title": "Add attachment",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Add attachment",
      "submitLabel": "Attach file",
      "fields": [
        {
          "key": "fileName",
          "label": "File name",
          "type": "text",
          "required": true,
          "defaultValue": "document.pdf"
        },
        {
          "key": "fileURL",
          "label": "File URL",
          "type": "text",
          "required": true,
          "defaultValue": "https://files.example.invalid/document.pdf"
        },
        {
          "key": "mimeType",
          "label": "MIME type",
          "type": "text",
          "defaultValue": "application/pdf"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "stock_items_attachment_create",
              "inputValues": {
                "entity": "stock_items",
                "entityID": "{{ state.variables.recordID }}",
                "fileName": "{{ event.formData.fileName }}",
                "fileURL": "{{ event.formData.fileURL }}",
                "mimeType": "{{ event.formData.mimeType }}",
                "uploadedBy": "{{ 1 }}"
              },
              "successToast": "Attachment linked",
              "errorToast": "Attachment failed"
            }
          }
        ]
      }
    }
