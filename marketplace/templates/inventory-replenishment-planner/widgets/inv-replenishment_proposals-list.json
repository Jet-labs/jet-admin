[
  {
    "slug": "inv-replenishment_proposals-list.heading",
    "key": "heading",
    "page": "inv-replenishment_proposals-list",
    "title": "Replenishment Proposals",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Replenishment Proposals\nBrowse, filter and update proposals. All edits are audit-logged and soft-deleted records can be restored from the record detail page.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.search",
    "key": "search",
    "page": "inv-replenishment_proposals-list",
    "title": "Search",
    "type": "search-input",
    "config": {
      "showHeader": false,
      "placeholder": "Search replenishment proposals...",
      "debounceMs": 350,
      "events": {
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.status",
    "key": "status",
    "page": "inv-replenishment_proposals-list",
    "title": "Status filter",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "All statuses",
      "defaultValue": "all",
      "options": [
        {
          "label": "All statuses",
          "value": "all"
        },
        {
          "label": "Draft",
          "value": "draft"
        },
        {
          "label": "Pending Approval",
          "value": "pending_approval"
        },
        {
          "label": "Approved",
          "value": "approved"
        },
        {
          "label": "Ordered",
          "value": "ordered"
        },
        {
          "label": "Received",
          "value": "received"
        },
        {
          "label": "Cancelled",
          "value": "cancelled"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.value === 'all' ? '' : event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.range",
    "key": "range",
    "page": "inv-replenishment_proposals-list",
    "title": "Date range",
