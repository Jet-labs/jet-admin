  {
    "slug": "inv-replenishment_proposals-list.total",
    "key": "total",
    "page": "inv-replenishment_proposals-list",
    "title": "Total records",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Total records",
      "valueTemplate": "{{ ((((state.queries.replenishment_proposals_stats || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.replenishment_proposals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.value",
    "key": "value",
    "page": "inv-replenishment_proposals-list",
    "title": "Total value",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Total value",
      "valueTemplate": "{{ ((((state.queries.replenishment_proposals_stats || {}).data || [])[0] || {}).total_value) }}",
      "prefix": "$",
      "isLoading": "{{ (state.queries.replenishment_proposals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.avg",
    "key": "avg",
    "page": "inv-replenishment_proposals-list",
    "title": "Average",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Average value",
      "valueTemplate": "{{ ((((state.queries.replenishment_proposals_stats || {}).data || [])[0] || {}).average_value) }}",
      "prefix": "$",
      "isLoading": "{{ (state.queries.replenishment_proposals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.selected",
    "key": "selected",
    "page": "inv-replenishment_proposals-list",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.replenishment_proposals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row to inspect it.",
      "isLoading": "{{ (state.queries.replenishment_proposals_selected || {}).isLoading || false }}"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.table",
    "key": "table",
    "page": "inv-replenishment_proposals-list",
    "title": "Replenishment Proposals",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.replenishment_proposals || {}).data || [])",
      "columns": [
        {
          "key": "proposal_code",
          "label": "Proposal",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "sku_id",
          "label": "SKU",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "warehouse_id",
          "label": "Warehouse",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "supplier_id",
          "label": "Supplier",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "urgency",
          "label": "Urgency",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "owner_id",
          "label": "Planner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "requested_qty",
          "label": "Requested qty",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "suggested_qty",
          "label": "Suggested qty",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "unit_cost",
          "label": "Unit cost",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "estimated_total",
          "label": "Estimated total",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "confidence_score",
          "label": "Confidence",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "needed_by_date",
          "label": "Needed by",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "approved_at",
          "label": "Approved at",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "rationale",
          "label": "Rationale",
          "sortable": false,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": true,
        "pageParam": "page",
        "pageSize": 10,
        "totalTemplate": "{{ ((state.queries.replenishment_proposals || {}).data && (state.queries.replenishment_proposals || {}).data[0] ? (state.queries.replenishment_proposals || {}).data[0].total_count : 0) }}"
      },
      "search": {
        "enabled": true,
        "serverSide": true,
        "placeholder": "Search proposals..."
      },
      "export": {
        "enabled": true,
        "format": "csv",
        "serverSide": false,
        "buttonLabel": "Export CSV"
      },
      "editing": {
        "enabled": true
      },
      "bulkEdit": {
        "enabled": false,
        "saveLabel": "Save changes"
      },
      "multiSelect": {
        "enabled": true,
        "showSelectAll": true,
        "actions": [
          {
            "label": "Archive selected",
            "actionKey": "archive",
            "variant": "destructive"
          }
        ]
      },
      "emptyText": "No proposals found.",
      "emptyHint": "Adjust the filters or create a new record.",
      "isLoading": "{{ (state.queries.replenishment_proposals || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ],
        "onPageChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": "{{ event.page }}"
            }
          }
        ],
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "replenishment_proposals_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "proposal_code": "{{ event.updatedRow.proposal_code }}",
                "sku_id": "{{ event.updatedRow.sku_id }}",
                "warehouse_id": "{{ event.updatedRow.warehouse_id }}",
                "supplier_id": "{{ event.updatedRow.supplier_id }}",
                "status": "{{ event.updatedRow.status }}",
                "urgency": "{{ event.updatedRow.urgency }}",
                "owner_id": "{{ event.updatedRow.owner_id }}",
                "requested_qty": "{{ event.updatedRow.requested_qty }}",
                "suggested_qty": "{{ event.updatedRow.suggested_qty }}",
                "unit_cost": "{{ event.updatedRow.unit_cost }}",
                "estimated_total": "{{ event.updatedRow.estimated_total }}",
                "confidence_score": "{{ event.updatedRow.confidence_score }}",
                "needed_by_date": "{{ event.updatedRow.needed_by_date }}",
                "approved_at": "{{ event.updatedRow.approved_at }}",
                "rationale": "{{ event.updatedRow.rationale }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ],
        "onBulkAction": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "replenishment_proposals_delete",
              "inputValues": {
                "ids": "{{ event.selectedRows.map(function (r) { return r.id; }) }}"
              },
              "successToast": "Records archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.actions",
    "key": "actions",
    "page": "inv-replenishment_proposals-list",
    "title": "Selected record actions",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record actions",
      "dataTemplate": "{{ (((state.queries.replenishment_proposals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row, then use the buttons below."
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.archive",
    "key": "archive",
    "page": "inv-replenishment_proposals-list",
    "title": "Archive selected",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive selected",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "replenishment_proposals_delete",
              "inputValues": {
                "ids": "{{ [state.variables.selectedID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.advance",
    "key": "advance",
    "page": "inv-replenishment_proposals-list",
    "title": "Advance status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Advance status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "replenishment_proposals_status",
              "inputValues": {
                "id": "{{ state.variables.selectedID }}",
                "status": "{{ \"pending_approval\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.explain",
    "key": "explain",
    "page": "inv-replenishment_proposals-list",
    "title": "List notes",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "Rows are loaded server-side. Use the table toolbar to search, sort and export the current view. Inline edits and bulk actions run the template's parameterized update queries and write to the audit log.",
      "format": "plain"
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.views",
    "key": "views",
    "page": "inv-replenishment_proposals-list",
    "title": "Saved views",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.replenishment_proposals_views || {}).data || [])",
      "columns": [
        {
          "key": "label",
          "label": "View",
          "type": "text",
          "sortable": false
        },
        {
          "key": "config_key",
          "label": "Key",
          "type": "text",
          "sortable": false
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false,
        "placeholder": "Filter saved views"
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No saved views yet.",
      "isLoading": "{{ (state.queries.replenishment_proposals_views || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.row.config_value.search || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.row.config_value.status || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.saveView",
    "key": "saveView",
    "page": "inv-replenishment_proposals-list",
    "title": "Save current view",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Save current view",
      "submitLabel": "Save view",
      "fields": [
        {
          "key": "name",
          "label": "View name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. My open replenishment proposals"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "replenishment_proposals_view_create",
              "inputValues": {
                "configKey": "{{ \"saved_view.inv-replenishment_proposals-list.\" + String(event.formData.name || \"view\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\") }}",
                "value": "{{ ({ search: state.variables.search, status: state.variables.status, page: 1 }) }}",
                "label": "{{ event.formData.name }}"
              },
              "successToast": "View saved",
              "errorToast": "Could not save view"
            }
          }
        ]
      }
    }
  }
]
