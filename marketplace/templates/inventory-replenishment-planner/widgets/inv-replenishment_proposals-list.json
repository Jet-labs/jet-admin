        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-replenishment_proposals-list.sort",
    "key": "sort",
    "page": "inv-replenishment_proposals-list",
    "title": "Sort",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Sort by",
