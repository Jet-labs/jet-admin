    "key": "attachmentForm",
    "page": "inv-purchase_orders-detail",
    "title": "Add attachment",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Add attachment",
      "submitLabel": "Attach file",
      "fields": [
        {
          "key": "fileName",
          "label": "File name",
          "type": "text",
          "required": true,
          "defaultValue": "document.pdf"
        },
        {
          "key": "fileURL",
          "label": "File URL",
          "type": "text",
          "required": true,
          "defaultValue": "https://files.example.invalid/document.pdf"
