[
  {
    "slug": "inv-purchase_orders-detail.heading",
    "key": "heading",
    "page": "inv-purchase_orders-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Purchase order detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "inv-purchase_orders-detail.status",
    "key": "status",
    "page": "inv-purchase_orders-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ ((((state.queries.purchase_orders_detail || {}).data || [])[0] || {}).status) }}",
      "variant": "default"
    }
  },
  {
    "slug": "inv-purchase_orders-detail.statusForm",
    "key": "statusForm",
    "page": "inv-purchase_orders-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "draft",
      "options": [
        {
          "label": "Draft",
          "value": "draft"
        },
        {
          "label": "Sent",
          "value": "sent"
        },
        {
          "label": "Confirmed",
          "value": "confirmed"
        },
        {
          "label": "Partially Received",
          "value": "partially_received"
        },
        {
          "label": "Received",
          "value": "received"
        },
        {
          "label": "Cancelled",
          "value": "cancelled"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-detail.statusButton",
    "key": "statusButton",
    "page": "inv-purchase_orders-detail",
    "title": "Apply status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Apply status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_status",
              "inputValues": {
                "id": "{{ state.variables.recordID }}",
                "status": "{{ (state.widgets[\"widget_5c20b295-1c6c-4b14-b850-250c547cebd0_1\"] || {}).value || \"draft\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-detail.delete",
    "key": "delete",
    "page": "inv-purchase_orders-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "inv-purchase_orders-detail.restore",
