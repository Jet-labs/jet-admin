  {
    "slug": "inv-purchase_orders-detail.editTable",
    "key": "editTable",
    "page": "inv-purchase_orders-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.purchase_orders_detail || {}).data || [])",
      "columns": [
        {
          "key": "po_number",
          "label": "PO number",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "supplier_id",
          "label": "Supplier",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "warehouse_id",
          "label": "Warehouse",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "total_value",
          "label": "Total value",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "expected_date",
          "label": "Expected",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "ordered_at",
          "label": "Ordered",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "received_at",
          "label": "Received",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "buyer_id",
          "label": "Buyer",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "sortable": false,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.purchase_orders_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "purchase_orders_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "po_number": "{{ event.updatedRow.po_number }}",
                "supplier_id": "{{ event.updatedRow.supplier_id }}",
                "warehouse_id": "{{ event.updatedRow.warehouse_id }}",
                "status": "{{ event.updatedRow.status }}",
                "total_value": "{{ event.updatedRow.total_value }}",
                "expected_date": "{{ event.updatedRow.expected_date }}",
                "ordered_at": "{{ event.updatedRow.ordered_at }}",
                "received_at": "{{ event.updatedRow.received_at }}",
                "buyer_id": "{{ event.updatedRow.buyer_id }}",
                "notes": "{{ event.updatedRow.notes }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
