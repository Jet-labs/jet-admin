[
  {
    "slug": "crm-record-created",
    "key": "record-created",
    "title": "Deals · record created",
    "description": "Inbound record-created event triggers intake triage.",
    "type": "webhook",
    "datasource": "webhook",
    "endpointPath": "crm-record-created",
    "status": "inactive",
    "config": {
      "pathSuffix": "crm-record-created",
      "responseStatusCode": 202,
      "responseBody": "{\"accepted\":true}"
    },
    "actions": [
      {
        "actionType": "transform",
        "actionConfig": {
          "script": "var e = event && event.body ? event.body : event; if (!e || e.kind !== \"record.created\") { return null; } return e;"
        }
      },
      {
        "actionType": "trigger_workflow",
        "actionConfig": {
          "workflowID": "75ba035e-0392-455e-9777-82ff217b7b32",
          "inputValues": {
            "recordID": "{{ event.record_id }}",
            "staffID": "{{ event.staff_id }}",
            "event": "{{ event }}"
          }
        }
      },
      {
        "actionType": "save_to_buffer",
        "actionConfig": {
          "bufferName": "crm_record-created",
          "maxRecords": 200,
          "maxAgeHours": 72,
          "retentionPolicy": "both"
        }
      }
    ]
  },
