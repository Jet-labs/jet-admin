  "shortDescription": "Run leads, accounts, deals and forecasting from one audited workspace.",
  "longDescription": "A complete revenue workspace: lead intake and scoring, account and contact management, a stage-based deal pipeline, activity tracking, quota attainment and forecast reporting. Includes a sales admin area for users, roles, audit, imports and data quality.",
  "author": "Jet Admin",
  "license": "MIT",
  "minPlatformVersion": "2.1.0-preview.1",
