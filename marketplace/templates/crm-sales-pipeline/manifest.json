    {
      "key": "createDemoUsers",
      "label": "Create demo staff directory",
      "type": "boolean",
      "default": false,
      "description": "Mark seeded staff as demo identities. These are not Firebase logins."
    },
    {
      "key": "enableAutomation",
      "label": "Enable cron automations",
      "type": "boolean",
      "default": false,
      "description": "Enable the packaged cron jobs. Leave off until listeners and integrations are reviewed."
