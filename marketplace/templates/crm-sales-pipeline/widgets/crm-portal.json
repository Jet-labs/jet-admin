  {
    "slug": "crm-portal.table",
    "key": "table",
    "page": "crm-portal",
    "title": "My records",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.portal || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Deal name",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "account_id",
          "label": "Account",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "contact_id",
          "label": "Primary contact",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "stage",
          "label": "Stage",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "amount",
          "label": "Amount",
          "sortable": true,
          "type": "number",
          "editable": false,
          "format": "0,0.00"
        },
        {
          "key": "probability",
          "label": "Probability %",
          "sortable": true,
          "type": "number",
          "editable": false
        },
        {
          "key": "close_date",
          "label": "Expected close",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "source",
          "label": "Source",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "next_step",
          "label": "Next step",
          "sortable": false,
          "type": "text",
          "editable": false
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No records are assigned to this contact.",
      "isLoading": "{{ (state.queries.portal || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-portal.detail",
    "key": "detail",
    "page": "crm-portal",
    "title": "Record summary",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record summary",
      "dataTemplate": "{{ (((state.queries.detail || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "isLoading": "{{ (state.queries.detail || {}).isLoading || false }}"
    }
  }
]
