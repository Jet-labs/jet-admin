[
  {
    "slug": "crm-accounts-detail.heading",
    "key": "heading",
    "page": "crm-accounts-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Account detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-accounts-detail.status",
    "key": "status",
    "page": "crm-accounts-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "—",
      "variant": "default"
    }
  },
  {
    "slug": "crm-accounts-detail.statusForm",
    "key": "statusForm",
    "page": "crm-accounts-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "",
      "options": [],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-accounts-detail.delete",
    "key": "delete",
    "page": "crm-accounts-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "accounts_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-accounts-detail.restore",
    "key": "restore",
    "page": "crm-accounts-detail",
    "title": "Restore",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Restore record",
      "variant": "outline",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "accounts_restore",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record restored",
              "errorToast": "Restore failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-accounts-detail.tabs",
    "key": "tabs",
    "page": "crm-accounts-detail",
    "title": "Record sections",
    "type": "tabs",
    "config": {
      "showHeader": false,
      "tabs": [
        {
          "label": "Overview",
          "value": "overview"
        },
        {
          "label": "Comments",
          "value": "comments"
        },
        {
          "label": "Attachments",
          "value": "attachments"
        },
        {
          "label": "Activity",
          "value": "activity"
        }
      ],
      "defaultTab": "overview",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "{{ event.value }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-accounts-detail.record",
    "key": "record",
    "page": "crm-accounts-detail",
    "title": "Record fields",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record fields",
      "dataTemplate": "{{ (((state.queries.accounts_detail || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "emptyText": "Record not found.",
      "isLoading": "{{ (state.queries.accounts_detail || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-accounts-detail.editTable",
    "key": "editTable",
    "page": "crm-accounts-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.accounts_detail || {}).data || [])",
      "columns": [
        {
          "key": "account_name",
          "label": "Account name",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "industry",
          "label": "Industry",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "tier",
          "label": "Tier",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "website",
          "label": "Website",
          "sortable": false,
          "type": "link",
          "editable": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "city",
          "label": "City",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "country",
          "label": "Country",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "annual_revenue",
          "label": "Annual revenue",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "health_score",
          "label": "Health score",
          "sortable": true,
          "type": "number",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.accounts_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "accounts_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "account_name": "{{ event.updatedRow.account_name }}",
                "industry": "{{ event.updatedRow.industry }}",
                "tier": "{{ event.updatedRow.tier }}",
                "website": "{{ event.updatedRow.website }}",
                "phone": "{{ event.updatedRow.phone }}",
                "city": "{{ event.updatedRow.city }}",
                "country": "{{ event.updatedRow.country }}",
                "owner_id": "{{ event.updatedRow.owner_id }}",
                "annual_revenue": "{{ event.updatedRow.annual_revenue }}",
                "health_score": "{{ event.updatedRow.health_score }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
