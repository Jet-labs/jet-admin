  {
    "slug": "crm-accounts-detail.attachments",
    "key": "attachments",
    "page": "crm-accounts-detail",
    "title": "Attachments",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.accounts_attachments || {}).data || [])",
      "columns": [
        {
          "key": "file_name",
          "label": "File",
          "type": "link"
        },
        {
          "key": "file_url",
          "label": "URL",
          "type": "link"
        },
        {
          "key": "mime_type",
          "label": "Type",
          "type": "text"
        },
        {
          "key": "created_at",
          "label": "Uploaded",
          "type": "date"
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true,
        "format": "csv"
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No attachments yet.",
      "isLoading": "{{ (state.queries.accounts_attachments || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-accounts-detail.attachmentForm",
    "key": "attachmentForm",
    "page": "crm-accounts-detail",
    "title": "Add attachment",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Add attachment",
      "submitLabel": "Attach file",
      "fields": [
        {
          "key": "fileName",
          "label": "File name",
          "type": "text",
          "required": true,
          "defaultValue": "document.pdf"
        },
        {
          "key": "fileURL",
          "label": "File URL",
          "type": "text",
          "required": true,
          "defaultValue": "https://files.example.invalid/document.pdf"
        },
        {
          "key": "mimeType",
          "label": "MIME type",
          "type": "text",
          "defaultValue": "application/pdf"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "accounts_attachment_create",
              "inputValues": {
                "entity": "accounts",
                "entityID": "{{ state.variables.recordID }}",
                "fileName": "{{ event.formData.fileName }}",
                "fileURL": "{{ event.formData.fileURL }}",
                "mimeType": "{{ event.formData.mimeType }}",
                "uploadedBy": "{{ 1 }}"
              },
              "successToast": "Attachment linked",
              "errorToast": "Attachment failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-accounts-detail.activity",
    "key": "activity",
    "page": "crm-accounts-detail",
    "title": "Audit timeline",
    "type": "timeline",
    "config": {
      "showHeader": true,
      "label": "Audit timeline",
      "dataTemplate": "{{ (state.queries.accounts_audit || {}).data || [] }}",
      "titleKey": "title",
      "timeKey": "created_at",
      "descriptionKey": "description",
      "emptyText": "No audit entries yet.",
      "isLoading": "{{ (state.queries.accounts_audit || {}).isLoading || false }}"
    }
  }
]
