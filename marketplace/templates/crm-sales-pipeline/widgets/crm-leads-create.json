[
  {
    "slug": "crm-leads-create.heading",
    "key": "heading",
    "page": "crm-leads-create",
    "title": "Create Lead",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Create Lead\nComplete the fields below. Required fields are validated before the parameterized insert query runs; the database trigger records the audit entry.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-leads-create.form",
    "key": "form",
    "page": "crm-leads-create",
    "title": "New Lead",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "New Lead",
      "submitLabel": "Create Lead",
      "resetLabel": "Reset",
      "layout": "grid",
      "columns": 2,
      "fields": [
        {
          "key": "name",
          "label": "Lead name",
          "type": "text",
          "required": true,
          "defaultValue": "Ravi Andersen"
        },
        {
          "key": "company",
          "label": "Company",
          "type": "text",
          "required": false,
          "defaultValue": "Orbit Collective"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "defaultValue": "eli.hassan.1@example.com"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "required": false,
          "defaultValue": "+1-555-351-4318"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "select",
          "required": true,
          "defaultValue": "event",
          "options": [
            {
              "label": "Website",
              "value": "website"
            },
            {
              "label": "Event",
              "value": "event"
            },
            {
              "label": "Referral",
              "value": "referral"
            },
            {
              "label": "Paid Search",
              "value": "paid_search"
            },
            {
              "label": "Partner",
              "value": "partner"
            },
            {
              "label": "Outbound",
              "value": "outbound"
            }
          ]
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "defaultValue": "contacted",
          "options": [
            {
              "label": "New",
              "value": "new"
            },
            {
              "label": "Contacted",
              "value": "contacted"
            },
            {
              "label": "Qualified",
              "value": "qualified"
            },
            {
              "label": "Unqualified",
              "value": "unqualified"
            },
            {
              "label": "Converted",
              "value": "converted"
            }
          ]
        },
        {
          "key": "score",
          "label": "Fit score",
          "type": "number",
          "required": true,
          "defaultValue": 57,
          "validation": {
            "min": 0
          }
        },
        {
          "key": "estimated_value",
          "label": "Estimated value",
          "type": "number",
          "required": false,
          "defaultValue": 5090.92,
          "validation": {
            "min": 0
          }
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "type": "select",
          "required": false,
          "defaultValue": 6,
          "options": [
            {
              "label": "Anika Osei",
              "value": 1
            },
            {
