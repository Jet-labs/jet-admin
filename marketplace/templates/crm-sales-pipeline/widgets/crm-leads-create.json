            {
              "label": "Anika Dubois",
              "value": 24
            }
          ]
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "textarea",
          "required": false,
          "defaultValue": "Regional availability approval renewal settlement handoff quarterly handoff documentation quarterly priority capacity.",
          "help": "Plain text or short notes"
        },
        {
          "key": "last_contact_at",
          "label": "Last contact",
          "type": "text",
          "required": false,
          "defaultValue": ""
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "leads_create",
              "inputValues": {
                "name": "{{ event.formData.name }}",
                "company": "{{ event.formData.company }}",
                "email": "{{ event.formData.email }}",
                "phone": "{{ event.formData.phone }}",
                "source": "{{ event.formData.source }}",
                "status": "{{ event.formData.status }}",
                "score": "{{ event.formData.score }}",
                "estimated_value": "{{ event.formData.estimated_value }}",
                "owner_id": "{{ event.formData.owner_id }}",
                "notes": "{{ event.formData.notes }}",
                "last_contact_at": "{{ event.formData.last_contact_at }}"
              },
              "successToast": "Record created",
              "errorToast": "Create failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-create.result",
    "key": "result",
    "page": "crm-leads-create",
    "title": "Created record",
    "type": "json-viewer",
    "config": {
      "showHeader": true,
      "label": "Created record",
      "dataTemplate": "{{ (state.queries.leads_create || {}).data || null }}",
      "isLoading": "{{ (state.queries.leads_create || {}).isLoading || false }}"
    }
  }
]
