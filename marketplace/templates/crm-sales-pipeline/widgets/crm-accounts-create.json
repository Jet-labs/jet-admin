[
  {
    "slug": "crm-accounts-create.heading",
    "key": "heading",
    "page": "crm-accounts-create",
    "title": "Create Account",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Create Account\nComplete the fields below. Required fields are validated before the parameterized insert query runs; the database trigger records the audit entry.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-accounts-create.form",
    "key": "form",
    "page": "crm-accounts-create",
    "title": "New Account",
    "type": "form",
