      "showHeader": true,
      "title": "New Account",
      "submitLabel": "Create Account",
      "resetLabel": "Reset",
      "layout": "grid",
      "columns": 2,
      "fields": [
        {
          "key": "account_name",
          "label": "Account name",
          "type": "text",
          "required": true,
          "defaultValue": "Pioneer Digital"
        },
        {
          "key": "industry",
          "label": "Industry",
          "type": "select",
          "required": true,
          "defaultValue": "financial_services",
          "options": [
            {
              "label": "Saas",
              "value": "saas"
            },
            {
              "label": "Financial Services",
              "value": "financial_services"
            },
            {
              "label": "Healthcare",
              "value": "healthcare"
            },
            {
              "label": "Manufacturing",
              "value": "manufacturing"
            },
            {
              "label": "Retail",
              "value": "retail"
            },
            {
              "label": "Logistics",
              "value": "logistics"
            },
            {
              "label": "Public Sector",
              "value": "public_sector"
            }
          ]
        },
        {
          "key": "tier",
          "label": "Tier",
          "type": "select",
          "required": true,
          "defaultValue": "enterprise",
          "options": [
            {
              "label": "Strategic",
              "value": "strategic"
            },
            {
              "label": "Enterprise",
