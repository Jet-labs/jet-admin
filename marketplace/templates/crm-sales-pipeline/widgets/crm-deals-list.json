[
  {
    "slug": "crm-deals-list.heading",
    "key": "heading",
    "page": "crm-deals-list",
    "title": "Deals",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Deals\nBrowse, filter and update deals. All edits are audit-logged and soft-deleted records can be restored from the record detail page.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-deals-list.search",
    "key": "search",
    "page": "crm-deals-list",
    "title": "Search",
    "type": "search-input",
    "config": {
      "showHeader": false,
      "placeholder": "Search deals...",
      "debounceMs": 350,
      "events": {
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.status",
    "key": "status",
    "page": "crm-deals-list",
    "title": "Status filter",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "All statuses",
      "defaultValue": "all",
      "options": [
        {
          "label": "All statuses",
          "value": "all"
        },
        {
          "label": "Prospecting",
          "value": "prospecting"
        },
        {
          "label": "Qualification",
          "value": "qualification"
        },
        {
          "label": "Proposal",
          "value": "proposal"
        },
        {
          "label": "Negotiation",
          "value": "negotiation"
        },
        {
          "label": "Closed Won",
          "value": "closed_won"
        },
        {
          "label": "Closed Lost",
          "value": "closed_lost"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.value === 'all' ? '' : event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.range",
    "key": "range",
    "page": "crm-deals-list",
    "title": "Date range",
    "type": "date-range-picker",
    "config": {
      "showHeader": false,
      "label": "",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.sort",
    "key": "sort",
    "page": "crm-deals-list",
    "title": "Sort",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Sort by",
      "defaultValue": "name",
      "options": [
        {
          "label": "Name",
          "value": "name"
        },
        {
          "label": "Amount",
          "value": "amount"
        },
        {
          "label": "Probability",
          "value": "probability"
        },
        {
          "label": "Close Date",
          "value": "close_date"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.sortBy",
              "value": "{{ event.value }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.total",
    "key": "total",
    "page": "crm-deals-list",
    "title": "Total records",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Total records",
      "valueTemplate": "{{ ((((state.queries.deals_stats || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.deals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-deals-list.value",
    "key": "value",
    "page": "crm-deals-list",
    "title": "Total value",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Total value",
      "valueTemplate": "{{ ((((state.queries.deals_stats || {}).data || [])[0] || {}).total_value) }}",
      "prefix": "$",
      "isLoading": "{{ (state.queries.deals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-deals-list.avg",
    "key": "avg",
    "page": "crm-deals-list",
    "title": "Average",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Average value",
      "valueTemplate": "{{ ((((state.queries.deals_stats || {}).data || [])[0] || {}).average_value) }}",
      "prefix": "$",
      "isLoading": "{{ (state.queries.deals_stats || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-deals-list.selected",
    "key": "selected",
    "page": "crm-deals-list",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.deals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row to inspect it.",
      "isLoading": "{{ (state.queries.deals_selected || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-deals-list.table",
    "key": "table",
    "page": "crm-deals-list",
    "title": "Deals",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.deals || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Deal name",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "account_id",
          "label": "Account",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "contact_id",
          "label": "Primary contact",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "stage",
          "label": "Stage",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "probability",
          "label": "Probability %",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "close_date",
          "label": "Expected close",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "source",
          "label": "Source",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "next_step",
          "label": "Next step",
          "sortable": false,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": true,
        "pageParam": "page",
        "pageSize": 10,
        "totalTemplate": "{{ ((state.queries.deals || {}).data && (state.queries.deals || {}).data[0] ? (state.queries.deals || {}).data[0].total_count : 0) }}"
      },
      "search": {
        "enabled": true,
        "serverSide": true,
        "placeholder": "Search deals..."
      },
      "export": {
        "enabled": true,
        "format": "csv",
        "serverSide": false,
        "buttonLabel": "Export CSV"
      },
      "editing": {
        "enabled": true
      },
      "bulkEdit": {
        "enabled": false,
        "saveLabel": "Save changes"
      },
      "multiSelect": {
        "enabled": true,
        "showSelectAll": true,
        "actions": [
          {
            "label": "Archive selected",
            "actionKey": "archive",
            "variant": "destructive"
          }
        ]
      },
      "emptyText": "No deals found.",
      "emptyHint": "Adjust the filters or create a new record.",
      "isLoading": "{{ (state.queries.deals || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ],
        "onPageChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": "{{ event.page }}"
            }
          }
        ],
        "onSearch": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.searchTerm || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ],
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "deals_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "name": "{{ event.updatedRow.name }}",
                "account_id": "{{ event.updatedRow.account_id }}",
                "contact_id": "{{ event.updatedRow.contact_id }}",
                "stage": "{{ event.updatedRow.stage }}",
                "amount": "{{ event.updatedRow.amount }}",
                "probability": "{{ event.updatedRow.probability }}",
                "close_date": "{{ event.updatedRow.close_date }}",
                "owner_id": "{{ event.updatedRow.owner_id }}",
                "source": "{{ event.updatedRow.source }}",
                "next_step": "{{ event.updatedRow.next_step }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ],
        "onBulkAction": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "deals_delete",
              "inputValues": {
                "ids": "{{ event.selectedRows.map(function (r) { return r.id; }) }}"
              },
              "successToast": "Records archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.actions",
    "key": "actions",
    "page": "crm-deals-list",
    "title": "Selected record actions",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record actions",
      "dataTemplate": "{{ (((state.queries.deals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a row, then use the buttons below."
    }
  },
  {
    "slug": "crm-deals-list.archive",
    "key": "archive",
    "page": "crm-deals-list",
    "title": "Archive selected",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive selected",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "deals_delete",
              "inputValues": {
                "ids": "{{ [state.variables.selectedID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.advance",
    "key": "advance",
    "page": "crm-deals-list",
    "title": "Advance status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Advance status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "deals_status",
              "inputValues": {
                "id": "{{ state.variables.selectedID }}",
                "status": "{{ \"qualification\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.explain",
    "key": "explain",
    "page": "crm-deals-list",
    "title": "List notes",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "Rows are loaded server-side. Use the table toolbar to search, sort and export the current view. Inline edits and bulk actions run the template's parameterized update queries and write to the audit log.",
      "format": "plain"
    }
  },
  {
    "slug": "crm-deals-list.views",
    "key": "views",
    "page": "crm-deals-list",
    "title": "Saved views",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.deals_views || {}).data || [])",
      "columns": [
        {
          "key": "label",
          "label": "View",
          "type": "text",
          "sortable": false
        },
        {
          "key": "config_key",
          "label": "Key",
          "type": "text",
          "sortable": false
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false,
        "placeholder": "Filter saved views"
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No saved views yet.",
      "isLoading": "{{ (state.queries.deals_views || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.search",
              "value": "{{ event.row.config_value.search || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.status",
              "value": "{{ event.row.config_value.status || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.page",
              "value": 1
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-list.saveView",
    "key": "saveView",
    "page": "crm-deals-list",
    "title": "Save current view",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Save current view",
      "submitLabel": "Save view",
      "fields": [
        {
          "key": "name",
          "label": "View name",
          "type": "text",
          "required": true,
          "placeholder": "e.g. My open deals"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "deals_view_create",
              "inputValues": {
                "configKey": "{{ \"saved_view.crm-deals-list.\" + String(event.formData.name || \"view\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\") }}",
                "value": "{{ ({ search: state.variables.search, status: state.variables.status, page: 1 }) }}",
                "label": "{{ event.formData.name }}"
              },
              "successToast": "View saved",
              "errorToast": "Could not save view"
            }
          }
        ]
      }
    }
  }
]
