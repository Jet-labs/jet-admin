[
  {
    "slug": "crm-deals-kanban.heading",
    "key": "heading",
    "page": "crm-deals-kanban",
    "title": "Deals board",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Deals board\nCards are grouped by **stage**. Select a card to inspect the record; drag-and-drop is intentionally not enabled because status changes must run through the audited transition query.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-deals-kanban.board",
    "key": "board",
    "page": "crm-deals-kanban",
    "title": "Pipeline board",
    "type": "kanban",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.deals || {}).data || [])",
      "groupBy": "stage",
      "titleKey": "name",
      "subtitleKey": "owner_id",
      "valueKey": "amount",
      "dateKey": "close_date",
      "badgeKey": "stage",
      "columns": [
        "prospecting",
        "qualification",
        "proposal",
        "negotiation",
        "closed_won",
        "closed_lost"
      ],
      "emptyText": "No cards in this pipeline.",
      "isLoading": "{{ (state.queries.deals || {}).isLoading || false }}",
      "events": {
        "onCardSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.card.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-deals-kanban.selected",
    "key": "selected",
    "page": "crm-deals-kanban",
    "title": "Selected card",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected card",
      "dataTemplate": "{{ (((state.queries.deals_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a card.",
      "isLoading": "{{ (state.queries.deals_selected || {}).isLoading || false }}"
    }
  }
]
