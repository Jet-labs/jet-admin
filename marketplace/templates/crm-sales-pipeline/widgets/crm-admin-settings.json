[
  {
    "slug": "crm-admin-settings.heading",
    "key": "heading",
    "page": "crm-admin-settings",
    "title": "System settings",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# System settings\nBranding, notification preferences and feature flags. Settings are stored as JSON and every write is audited.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-admin-settings.settings",
    "key": "settings",
    "page": "crm-admin-settings",
    "title": "Configuration",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.settings || {}).data || [])",
      "columns": [
        {
          "key": "kind",
          "label": "Kind",
          "type": "badge"
        },
        {
          "key": "config_key",
          "label": "Key",
          "type": "text"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "updated_at",
          "label": "Updated",
          "type": "date"
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No settings.",
      "isLoading": "{{ (state.queries.settings || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-admin-settings.flagForm",
    "key": "flagForm",
    "page": "crm-admin-settings",
    "title": "Toggle feature flag",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Toggle feature flag",
      "submitLabel": "Save flag",
      "fields": [
        {
          "key": "configKey",
          "label": "Flag",
          "type": "select",
          "required": true,
          "options": [
            {
              "label": "Bulk actions",
              "value": "flags.bulkActions"
            },
            {
              "label": "CSV import",
              "value": "flags.csvImport"
            },
            {
              "label": "Workflow automation",
              "value": "flags.workflowAutomation"
            },
            {
              "label": "External portal",
              "value": "flags.externalPortal"
            }
          ]
        },
        {
          "key": "value",
          "label": "Enabled",
          "type": "checkbox",
          "defaultValue": true
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "update",
              "inputValues": {
                "kind": "feature_flag",
                "configKey": "{{ event.formData.configKey }}",
                "value": "{{ ({ value: event.formData.value }) }}"
              },
              "successToast": "Flag saved",
              "errorToast": "Flag failed"
            }
          }
        ]
      }
    }
  }
]
