  {
    "slug": "crm-dashboard.qualityBadge",
    "key": "qualityBadge",
    "page": "crm-dashboard",
    "title": "Data quality issues",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ String(((state.queries.quality || {}).data || []).reduce(function (n, r) { return n + Number(r.affected_rows || 0); }, 0)) + \" issues\" }}",
      "variant": "warning"
    }
  },
  {
    "slug": "crm-dashboard.kpiTotal",
    "key": "kpiTotal",
    "page": "crm-dashboard",
    "title": "Deals",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Deals",
      "valueTemplate": "{{ ((((state.queries.deals_summary || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.deals_summary || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.kpiValue",
    "key": "kpiValue",
    "page": "crm-dashboard",
    "title": "Total value",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Total value",
      "prefix": "$",
      "valueTemplate": "{{ ((((state.queries.deals_summary || {}).data || [])[0] || {}).total_value) }}",
      "isLoading": "{{ (state.queries.deals_summary || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.kpiSecond",
    "key": "kpiSecond",
    "page": "crm-dashboard",
    "title": "Leads",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Leads",
      "valueTemplate": "{{ ((((state.queries.leads_summary || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.leads_summary || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.kpiTasks",
    "key": "kpiTasks",
    "page": "crm-dashboard",
    "title": "Tasks for me",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Tasks for me",
      "valueTemplate": "{{ (((state.queries.my_tasks || {}).data || []).length) }}",
      "isLoading": "{{ (state.queries.my_tasks || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.trend",
    "key": "trend",
    "page": "crm-dashboard",
    "title": "Volume trend",
    "type": "vega-lite",
    "config": {
      "showHeader": true,
      "label": "Volume trend",
      "vegaSpec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "width": "container",
        "height": "container",
        "autosize": {
          "type": "fit",
          "contains": "padding"
        },
        "data": {
          "values": "{{ (state.queries.deals_trend || {}).data || [] }}"
        },
        "mark": {
          "type": "line",
          "tooltip": true,
          "point": true
        },
        "encoding": {
          "x": {
            "field": "day",
            "type": "temporal",
            "axis": {
              "labelAngle": 0
            }
          },
          "y": {
            "field": "count",
            "type": "quantitative"
          },
          "color": {
            "value": "#2563eb"
          }
        }
      },
      "options": {
        "renderer": "svg",
        "showActions": false
      },
      "isLoading": "{{ (state.queries.deals_trend || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.statusChart",
    "key": "statusChart",
    "page": "crm-dashboard",
    "title": "By status",
    "type": "vega-lite",
    "config": {
      "showHeader": true,
      "label": "By status",
      "vegaSpec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "width": "container",
        "height": "container",
        "autosize": {
          "type": "fit",
          "contains": "padding"
        },
        "data": {
          "values": "{{ (state.queries.deals_status_chart || {}).data || [] }}"
        },
        "mark": {
          "type": "arc",
          "innerRadius": 55,
          "tooltip": true
        },
        "encoding": {
          "theta": {
            "field": "count",
            "type": "quantitative"
          },
          "color": {
            "field": "status",
            "type": "nominal"
          }
        }
      },
      "options": {
        "renderer": "svg",
        "showActions": false
      },
      "isLoading": "{{ (state.queries.deals_status_chart || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.tasks",
    "key": "tasks",
    "page": "crm-dashboard",
    "title": "Tasks for me",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.my_tasks || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Deal name",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "account_id",
          "label": "Account",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "contact_id",
          "label": "Primary contact",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "stage",
          "label": "Stage",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "amount",
          "label": "Amount",
          "sortable": true,
          "type": "number",
          "editable": false,
          "format": "0,0.00"
        },
        {
          "key": "probability",
          "label": "Probability %",
          "sortable": true,
          "type": "number",
          "editable": false
        },
        {
          "key": "close_date",
          "label": "Expected close",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "source",
          "label": "Source",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "next_step",
          "label": "Next step",
          "sortable": false,
          "type": "text",
          "editable": false
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No open tasks for this staff member.",
      "isLoading": "{{ (state.queries.my_tasks || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.notifications",
    "key": "notifications",
    "page": "crm-dashboard",
    "title": "Notifications",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.notifications || {}).data || [])",
      "columns": [
        {
          "key": "title",
          "label": "Notification",
          "type": "text"
        },
        {
          "key": "category",
          "label": "Category",
          "type": "badge"
        },
        {
          "key": "created_at",
          "label": "Created",
          "type": "date"
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 5
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No notifications.",
      "isLoading": "{{ (state.queries.notifications || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-dashboard.activity",
    "key": "activity",
    "page": "crm-dashboard",
    "title": "Recent activity",
    "type": "timeline",
    "config": {
      "showHeader": true,
      "label": "Recent activity",
      "dataTemplate": "{{ (state.queries.recent_activity || {}).data || [] }}",
      "titleKey": "title",
      "timeKey": "created_at",
      "descriptionKey": "description",
      "emptyText": "No activity yet.",
      "isLoading": "{{ (state.queries.recent_activity || {}).isLoading || false }}"
    }
  }
]
