[
  {
    "slug": "crm-leads-detail.heading",
    "key": "heading",
    "page": "crm-leads-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Lead detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-leads-detail.status",
    "key": "status",
    "page": "crm-leads-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ ((((state.queries.leads_detail || {}).data || [])[0] || {}).status) }}",
      "variant": "default"
    }
  },
  {
    "slug": "crm-leads-detail.statusForm",
    "key": "statusForm",
    "page": "crm-leads-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "new",
      "options": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Contacted",
          "value": "contacted"
        },
        {
          "label": "Qualified",
          "value": "qualified"
        },
        {
          "label": "Unqualified",
          "value": "unqualified"
        },
        {
          "label": "Converted",
          "value": "converted"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-detail.statusButton",
    "key": "statusButton",
    "page": "crm-leads-detail",
    "title": "Apply status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Apply status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "leads_status",
              "inputValues": {
                "id": "{{ state.variables.recordID }}",
                "status": "{{ (state.widgets[\"widget_f30b80c8-4bcb-439f-a695-e9a39b269f7f_1\"] || {}).value || \"new\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-detail.delete",
    "key": "delete",
    "page": "crm-leads-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "leads_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-detail.restore",
    "key": "restore",
    "page": "crm-leads-detail",
    "title": "Restore",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Restore record",
      "variant": "outline",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "leads_restore",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record restored",
              "errorToast": "Restore failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-detail.tabs",
    "key": "tabs",
    "page": "crm-leads-detail",
    "title": "Record sections",
    "type": "tabs",
    "config": {
      "showHeader": false,
      "tabs": [
        {
          "label": "Overview",
          "value": "overview"
        },
        {
          "label": "Comments",
          "value": "comments"
        },
        {
          "label": "Attachments",
          "value": "attachments"
        },
        {
          "label": "Activity",
          "value": "activity"
        }
      ],
      "defaultTab": "overview",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "{{ event.value }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-leads-detail.record",
    "key": "record",
    "page": "crm-leads-detail",
    "title": "Record fields",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record fields",
      "dataTemplate": "{{ (((state.queries.leads_detail || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "emptyText": "Record not found.",
      "isLoading": "{{ (state.queries.leads_detail || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-leads-detail.editTable",
    "key": "editTable",
    "page": "crm-leads-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.leads_detail || {}).data || [])",
      "columns": [
        {
          "key": "name",
          "label": "Lead name",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "company",
          "label": "Company",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "email",
          "label": "Email",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "source",
          "label": "Source",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "score",
          "label": "Fit score",
          "sortable": true,
          "type": "number",
          "editable": true
        },
        {
          "key": "estimated_value",
          "label": "Estimated value",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "last_contact_at",
          "label": "Last contact",
          "sortable": true,
          "type": "date",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.leads_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "leads_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "name": "{{ event.updatedRow.name }}",
                "company": "{{ event.updatedRow.company }}",
                "email": "{{ event.updatedRow.email }}",
                "phone": "{{ event.updatedRow.phone }}",
                "source": "{{ event.updatedRow.source }}",
                "status": "{{ event.updatedRow.status }}",
                "score": "{{ event.updatedRow.score }}",
                "estimated_value": "{{ event.updatedRow.estimated_value }}",
                "owner_id": "{{ event.updatedRow.owner_id }}",
                "notes": "{{ event.updatedRow.notes }}",
                "last_contact_at": "{{ event.updatedRow.last_contact_at }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
