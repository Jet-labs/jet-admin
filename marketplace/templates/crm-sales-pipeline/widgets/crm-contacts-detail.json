[
  {
    "slug": "crm-contacts-detail.heading",
    "key": "heading",
    "page": "crm-contacts-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Contact detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "crm-contacts-detail.status",
    "key": "status",
    "page": "crm-contacts-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ ((((state.queries.contacts_detail || {}).data || [])[0] || {}).status) }}",
      "variant": "default"
    }
  },
  {
    "slug": "crm-contacts-detail.statusForm",
    "key": "statusForm",
    "page": "crm-contacts-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "active",
      "options": [
        {
          "label": "Active",
          "value": "active"
        },
        {
          "label": "Inactive",
          "value": "inactive"
        },
        {
          "label": "Bounced",
          "value": "bounced"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-contacts-detail.statusButton",
    "key": "statusButton",
    "page": "crm-contacts-detail",
    "title": "Apply status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Apply status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "contacts_status",
              "inputValues": {
                "id": "{{ state.variables.recordID }}",
                "status": "{{ (state.widgets[\"widget_1207cfc9-1b02-4d43-b1c3-e8a959ce4404_1\"] || {}).value || \"active\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-contacts-detail.delete",
    "key": "delete",
    "page": "crm-contacts-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "contacts_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-contacts-detail.restore",
    "key": "restore",
    "page": "crm-contacts-detail",
    "title": "Restore",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Restore record",
      "variant": "outline",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "contacts_restore",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record restored",
              "errorToast": "Restore failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-contacts-detail.tabs",
    "key": "tabs",
    "page": "crm-contacts-detail",
    "title": "Record sections",
    "type": "tabs",
    "config": {
      "showHeader": false,
      "tabs": [
        {
          "label": "Overview",
          "value": "overview"
        },
        {
          "label": "Comments",
          "value": "comments"
        },
        {
          "label": "Attachments",
          "value": "attachments"
        },
        {
          "label": "Activity",
          "value": "activity"
        }
      ],
      "defaultTab": "overview",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "{{ event.value }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "crm-contacts-detail.record",
    "key": "record",
    "page": "crm-contacts-detail",
    "title": "Record fields",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record fields",
      "dataTemplate": "{{ (((state.queries.contacts_detail || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "emptyText": "Record not found.",
      "isLoading": "{{ (state.queries.contacts_detail || {}).isLoading || false }}"
    }
  },
  {
    "slug": "crm-contacts-detail.editTable",
    "key": "editTable",
    "page": "crm-contacts-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.contacts_detail || {}).data || [])",
      "columns": [
        {
          "key": "full_name",
          "label": "Full name",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "email",
          "label": "Email",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": true
        },
        {
          "key": "job_title",
          "label": "Job title",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "account_id",
          "label": "Account",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "last_touch_at",
          "label": "Last touch",
          "sortable": true,
          "type": "date",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.contacts_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "contacts_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "full_name": "{{ event.updatedRow.full_name }}",
                "email": "{{ event.updatedRow.email }}",
                "phone": "{{ event.updatedRow.phone }}",
                "job_title": "{{ event.updatedRow.job_title }}",
                "account_id": "{{ event.updatedRow.account_id }}",
                "owner_id": "{{ event.updatedRow.owner_id }}",
                "status": "{{ event.updatedRow.status }}",
                "last_touch_at": "{{ event.updatedRow.last_touch_at }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
