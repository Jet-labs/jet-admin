        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "delayType": "fixed",
        "delayMs": 250
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "70236042-13b6-49a8-9cb8-5c15929f10b6",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "dataQueryID": "e67ba7fe-6c07-4d21-bbac-158f8eea0513",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "readPriority",
      "nodeID": "eccb1264-df22-4a4b-a158-7bac94a7a624",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "readPriority",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nreturn { id: r.id || ctx.recordID, priority: String(r.stage || \"\"), ownerID: Number(r.owner_id || ctx.staffID) };\n",
        "outputVariable": "record"
      }
    },
    {
      "key": "needsEscalation",
      "nodeID": "5ec77a7c-afea-401a-89a7-d09192a5b386",
      "type": "condition",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "needsEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "branches": [
          {
            "id": "escalate",
            "label": "Escalate",
            "condition": "['urgent','high','critical','overdue'].indexOf(String(ctx.record.priority).toLowerCase()) >= 0"
          }
        ],
        "defaultBranch": "normal"
      }
    },
    {
      "key": "notifyEscalation",
      "nodeID": "55ea787b-f6dd-450f-96d1-6f94c2b8a225",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "dataQueryID": "3b694978-816f-4fb5-8c10-ce5a1042b5de",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.record.ownerID }}",
          "title": "Deals escalation",
          "body": "Record #{{ ctx.record.id }} was escalated after the response window.",
          "category": "warning",
          "linkPage": "crm-deals-list"
        }
      }
    },
    {
