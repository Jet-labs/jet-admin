{
  "slug": "crm.document-generation",
  "key": "document-generation",
  "title": "Deals · document generation",
  "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
  "tags": [
    "automation",
    "documents"
  ],
  "options": {
    "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
    "inputDefinitions": [
      {
        "key": "recordID",
        "type": "number",
        "required": false,
        "defaultValue": 1
      }
    ],
    "workflowRunTimeout": 600,
    "workflowTaskTimeout": 60,
    "humanInLoopTimeout": 3600,
    "defaultNodeTimeoutSeconds": 30,
    "defaultRetryLimit": 1,
    "defaultRetryDelaySeconds": 3,
    "nodeDefaults": {
      "javascript": {
        "timeoutSeconds": 10,
        "retryLimit": 1,
        "retryDelaySeconds": 1
      },
      "dataQuery": {
        "timeoutSeconds": 30,
        "retryLimit": 1,
        "retryDelaySeconds": 2
      }
    }
  },
  "nodes": [
    {
      "key": "start",
      "nodeID": "a925002f-3299-4cbb-84ff-f226e7d9a4f4",
      "type": "start",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "start",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "b6eecd01-a077-42a9-8567-c91a93c9f8c9",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "dataQueryID": "e67ba7fe-6c07-4d21-bbac-158f8eea0513",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "buildDocument",
      "nodeID": "6b215622-bb6a-48f0-90ee-0d0b816db0c4",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "buildDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nvar html = \"<h1>\" + String(r.name || \"Record\") + \"</h1><p>Record #\" + String(r.id) + \"</p>\";\nreturn { fileName: \"deals-\" + String(r.id || ctx.recordID) + \".pdf\", fileURL: \"https://files.example.invalid/crm-sales-pipeline/\" + String(r.id || ctx.recordID) + \".pdf\", mimeType: \"application/pdf\", html: html };\n",
        "outputVariable": "document"
      }
    },
    {
      "key": "linkDocument",
      "nodeID": "e7aecced-bc71-478c-9937-67f1e526c306",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "linkDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "dataQueryID": "ee33b2fa-4e90-4b66-83a7-8290af5401f2",
        "outputVariable": "attachment",
        "inputValues": {
          "entity": "deals",
          "entityID": "{{ ctx.recordID }}",
          "fileName": "{{ ctx.document.fileName }}",
          "fileURL": "{{ ctx.document.fileURL }}",
          "mimeType": "{{ ctx.document.mimeType }}",
          "uploadedBy": "{{ ctx.staffID || 1 }}"
        }
      }
    },
    {
      "key": "notifyDocument",
      "nodeID": "ddc6db64-7099-4185-842c-b754cb2f9064",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "dataQueryID": "3b694978-816f-4fb5-8c10-ce5a1042b5de",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.staffID || 1 }}",
          "title": "Deals document ready",
          "body": "Document {{ ctx.document.fileName }} was generated for record #{{ ctx.recordID }}.",
          "category": "success",
          "linkPage": "crm-deals-detail"
        }
      }
    },
    {
      "key": "done",
      "nodeID": "aef2c496-689e-4ca7-a678-81adf79d930b",
      "type": "end",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "done",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "outputParameters": [
          {
            "name": "result",
            "sourceVariable": "{{ ctx.document }}"
          }
        ]
      }
    }
  ],
