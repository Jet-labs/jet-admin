    "type": "webhook",
    "datasource": "webhook",
    "endpointPath": "ap-record-created",
    "status": "inactive",
    "config": {
      "pathSuffix": "ap-record-created",
      "responseStatusCode": 202,
      "responseBody": "{\"accepted\":true}"
    },
    "actions": [
      {
        "actionType": "transform",
        "actionConfig": {
          "script": "var e = event && event.body ? event.body : event; if (!e || e.kind !== \"record.created\") { return null; } return e;"
        }
      },
      {
        "actionType": "trigger_workflow",
        "actionConfig": {
          "workflowID": "84c12cb9-fa4f-4e68-ab0f-a730db73ea15",
          "inputValues": {
            "recordID": "{{ event.record_id }}",
            "staffID": "{{ event.staff_id }}",
            "event": "{{ event }}"
          }
        }
      },
      {
        "actionType": "save_to_buffer",
        "actionConfig": {
          "bufferName": "ap_record-created",
          "maxRecords": 200,
          "maxAgeHours": 72,
          "retentionPolicy": "both"
        }
      }
    ]
  },
