  {
    "slug": "ap-profile.profile",
    "key": "profile",
    "page": "ap-profile",
    "title": "Profile",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Profile",
      "dataTemplate": "{{ (((state.queries.profile || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "isLoading": "{{ (state.queries.profile || {}).isLoading || false }}"
    }
  },
  {
    "slug": "ap-profile.form",
    "key": "form",
    "page": "ap-profile",
    "title": "Edit profile",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "Edit profile",
      "submitLabel": "Save profile",
      "layout": "grid",
      "columns": 2,
      "fields": [
        {
          "key": "fullName",
          "label": "Full name",
          "type": "text",
          "required": true
        },
        {
          "key": "department",
          "label": "Department",
          "type": "text"
        },
        {
          "key": "jobTitle",
          "label": "Job title",
          "type": "text"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text"
        },
        {
          "key": "city",
          "label": "City",
          "type": "text"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "update",
              "inputValues": {
                "id": "{{ state.variables.staffID }}",
                "fullName": "{{ event.formData.fullName }}",
                "department": "{{ event.formData.department }}",
                "jobTitle": "{{ event.formData.jobTitle }}",
                "phone": "{{ event.formData.phone }}",
                "city": "{{ event.formData.city }}"
              },
              "successToast": "Profile saved",
              "errorToast": "Profile update failed"
            }
          }
        ]
      }
    }
  }
]
