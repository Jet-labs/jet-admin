[
  {
    "slug": "ap-notifications.heading",
    "key": "heading",
    "page": "ap-notifications",
    "title": "Notifications",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Notifications\nIn-app notifications generated by workflows, SLA sweeps and digest jobs. Mark one or more as read; the action is audited.",
      "format": "markdown"
    }
  },
  {
    "slug": "ap-notifications.table",
    "key": "table",
    "page": "ap-notifications",
    "title": "Inbox",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.notifications || {}).data || [])",
      "columns": [
        {
          "key": "title",
          "label": "Title",
          "type": "text"
        },
        {
          "key": "body",
          "label": "Body",
          "type": "text"
        },
        {
          "key": "category",
          "label": "Category",
          "type": "badge"
        },
        {
          "key": "is_read",
          "label": "Read",
          "type": "boolean"
        },
        {
          "key": "created_at",
          "label": "Created",
          "type": "date"
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": true,
        "showSelectAll": true,
        "actions": [
          {
            "label": "Mark read",
            "actionKey": "mark-read",
            "variant": "default"
          }
        ]
      },
      "emptyText": "No notifications.",
      "isLoading": "{{ (state.queries.notifications || {}).isLoading || false }}",
      "events": {
        "onBulkAction": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "read",
              "inputValues": {
                "ids": "{{ event.selectedRows.map(function (r) { return r.id; }) }}"
              },
              "successToast": "Marked as read",
              "errorToast": "Mark read failed"
            }
          }
        ]
      }
    }
  }
]
