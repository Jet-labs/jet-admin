[
  {
    "slug": "ap-dashboard.heading",
    "key": "heading",
    "page": "ap-dashboard",
    "title": "Dashboard",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Invoice Matching Desk\nOperational overview for the current team. Use the date range to scope the metrics; tasks and notifications are filtered by the selected staff member.",
      "format": "markdown"
    }
  },
  {
    "slug": "ap-dashboard.range",
    "key": "range",
    "page": "ap-dashboard",
    "title": "Date range",
    "type": "date-range-picker",
    "config": {
      "showHeader": false,
      "label": "Reporting window",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          }
        ]
      }
    }
  },
