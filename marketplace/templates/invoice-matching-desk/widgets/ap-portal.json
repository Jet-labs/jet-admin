  {
    "slug": "ap-portal.table",
    "key": "table",
    "page": "ap-portal",
    "title": "My records",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.portal || {}).data || [])",
      "columns": [
        {
          "key": "invoice_number",
          "label": "Invoice number",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "supplier_id",
          "label": "Supplier",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "po_id",
          "label": "Purchase order",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "total_amount",
          "label": "Total amount",
          "sortable": true,
          "type": "number",
          "editable": false,
          "format": "0,0.00"
        },
        {
          "key": "currency",
          "label": "Currency",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "invoice_date",
          "label": "Invoice date",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "due_date",
          "label": "Due date",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "received_at",
          "label": "Received at",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "match_score",
          "label": "Match score",
          "sortable": true,
          "type": "number",
          "editable": false
        },
        {
          "key": "discrepancy_count",
          "label": "Discrepancies",
          "sortable": true,
          "type": "number",
          "editable": false
        },
        {
          "key": "owner_id",
          "label": "Owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "sortable": false,
          "type": "text",
          "editable": false
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No records are assigned to this contact.",
      "isLoading": "{{ (state.queries.portal || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "ap-portal.detail",
    "key": "detail",
    "page": "ap-portal",
    "title": "Record summary",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record summary",
      "dataTemplate": "{{ (((state.queries.detail || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "isLoading": "{{ (state.queries.detail || {}).isLoading || false }}"
    }
  }
]
