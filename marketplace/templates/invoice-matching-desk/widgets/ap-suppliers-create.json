[
  {
    "slug": "ap-suppliers-create.heading",
    "key": "heading",
    "page": "ap-suppliers-create",
    "title": "Create Supplier",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Create Supplier\nComplete the fields below. Required fields are validated before the parameterized insert query runs; the database trigger records the audit entry.",
      "format": "markdown"
    }
  },
  {
    "slug": "ap-suppliers-create.form",
    "key": "form",
    "page": "ap-suppliers-create",
    "title": "New Supplier",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "New Supplier",
      "submitLabel": "Create Supplier",
      "resetLabel": "Reset",
      "layout": "grid",
      "columns": 2,
      "fields": [
        {
          "key": "name",
          "label": "Supplier",
          "type": "text",
          "required": true,
          "defaultValue": "Atlas Digital"
        },
        {
          "key": "code",
          "label": "Code",
          "type": "text",
          "required": true,
          "defaultValue": "SUP-00001"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "defaultValue": "on_hold",
          "options": [
            {
              "label": "Active",
              "value": "active"
            },
            {
              "label": "On Hold",
              "value": "on_hold"
            },
            {
              "label": "Inactive",
              "value": "inactive"
            }
          ]
        },
        {
          "key": "contact_name",
          "label": "Contact",
          "type": "text",
          "required": false,
          "defaultValue": "Mira Dubois"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": false,
          "defaultValue": "theo.bennett.1@example.com"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "required": false,
          "defaultValue": "+1-555-957-5254"
        },
        {
          "key": "payment_terms",
          "label": "Payment terms",
          "type": "select",
          "required": true,
          "defaultValue": "net_45",
          "options": [
            {
              "label": "Net 30",
              "value": "net_30"
            },
            {
              "label": "Net 45",
              "value": "net_45"
            },
            {
              "label": "Net 60",
              "value": "net_60"
            },
            {
              "label": "Prepaid",
              "value": "prepaid"
            }
          ]
        },
        {
          "key": "lead_time_days",
          "label": "Lead time (days)",
          "type": "number",
          "required": false,
          "defaultValue": 12,
          "validation": {
            "min": 0
          }
        },
        {
          "key": "tax_id",
          "label": "Tax ID",
          "type": "text",
          "required": false,
          "defaultValue": "Quarterly routing follow-up priority exception."
        },
        {
          "key": "address",
          "label": "Address",
          "type": "textarea",
          "required": false,
          "defaultValue": "78 Harbor Street, London",
          "help": "Plain text or short notes"
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "suppliers_create",
              "inputValues": {
                "name": "{{ event.formData.name }}",
                "code": "{{ event.formData.code }}",
                "status": "{{ event.formData.status }}",
                "contact_name": "{{ event.formData.contact_name }}",
                "email": "{{ event.formData.email }}",
                "phone": "{{ event.formData.phone }}",
                "payment_terms": "{{ event.formData.payment_terms }}",
                "lead_time_days": "{{ event.formData.lead_time_days }}",
                "tax_id": "{{ event.formData.tax_id }}",
                "address": "{{ event.formData.address }}"
              },
              "successToast": "Record created",
              "errorToast": "Create failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "ap-suppliers-create.result",
    "key": "result",
    "page": "ap-suppliers-create",
    "title": "Created record",
    "type": "json-viewer",
    "config": {
      "showHeader": true,
      "label": "Created record",
      "dataTemplate": "{{ (state.queries.suppliers_create || {}).data || null }}",
      "isLoading": "{{ (state.queries.suppliers_create || {}).isLoading || false }}"
    }
  }
]
