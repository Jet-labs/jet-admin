[
  {
    "slug": "ap-invoices-kanban.heading",
    "key": "heading",
    "page": "ap-invoices-kanban",
    "title": "Invoices board",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Invoices board\nCards are grouped by **status**. Select a card to inspect the record; drag-and-drop is intentionally not enabled because status changes must run through the audited transition query.",
      "format": "markdown"
    }
  },
  {
    "slug": "ap-invoices-kanban.board",
    "key": "board",
    "page": "ap-invoices-kanban",
    "title": "Pipeline board",
    "type": "kanban",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.invoices || {}).data || [])",
      "groupBy": "status",
      "titleKey": "invoice_number",
      "subtitleKey": "owner_id",
      "valueKey": "total_amount",
      "dateKey": "invoice_date",
      "badgeKey": "status",
      "columns": [
        "received",
        "matching",
        "exception",
        "approved",
        "scheduled",
        "paid",
        "void"
      ],
      "emptyText": "No cards in this pipeline.",
      "isLoading": "{{ (state.queries.invoices || {}).isLoading || false }}",
      "events": {
        "onCardSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.card.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "ap-invoices-kanban.selected",
    "key": "selected",
    "page": "ap-invoices-kanban",
    "title": "Selected card",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected card",
      "dataTemplate": "{{ (((state.queries.invoices_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select a card.",
      "isLoading": "{{ (state.queries.invoices_selected || {}).isLoading || false }}"
    }
  }
]
