{
  "slug": "ap.escalation",
  "key": "escalation",
  "title": "Invoices · escalation",
  "description": "Waits for a configurable delay, then escalates high-priority records and notifies the manager.",
  "tags": [
    "automation",
    "escalation"
  ],
  "options": {
    "description": "Waits for a configurable delay, then escalates high-priority records and notifies the manager.",
    "inputDefinitions": [
      {
        "key": "recordID",
        "type": "number",
        "required": false,
        "defaultValue": 1
      },
      {
        "key": "staffID",
        "type": "number",
        "required": false,
        "defaultValue": 1
      }
    ],
    "workflowRunTimeout": 600,
    "workflowTaskTimeout": 60,
    "humanInLoopTimeout": 3600,
    "defaultNodeTimeoutSeconds": 30,
    "defaultRetryLimit": 1,
    "defaultRetryDelaySeconds": 3,
    "nodeDefaults": {
      "javascript": {
        "timeoutSeconds": 10,
        "retryLimit": 1,
        "retryDelaySeconds": 1
      },
      "dataQuery": {
        "timeoutSeconds": 30,
        "retryLimit": 1,
        "retryDelaySeconds": 2
      }
    }
  },
  "nodes": [
    {
      "key": "start",
      "nodeID": "3546097b-e436-480d-ac64-b195949c104c",
      "type": "start",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "start",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "key": "waitForResponse",
      "nodeID": "2250121e-8a84-43ab-8125-8bdae13fcf24",
      "type": "delay",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "waitForResponse",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "delayType": "fixed",
        "delayMs": 250
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "2c1ee0aa-0913-4737-893d-e0cafd1fa123",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "dataQueryID": "aeb98a5c-052e-4535-89f6-6acfb820e2ce",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "readPriority",
      "nodeID": "ce7e04b7-3ced-46f9-97ac-87aa474d634b",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "readPriority",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nreturn { id: r.id || ctx.recordID, priority: String(r.status || \"\"), ownerID: Number(r.owner_id || ctx.staffID) };\n",
        "outputVariable": "record"
      }
    },
    {
      "key": "needsEscalation",
      "nodeID": "963b7c94-99c5-4ff3-bdcb-82599147f7d6",
      "type": "condition",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "needsEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "branches": [
          {
            "id": "escalate",
            "label": "Escalate",
            "condition": "['urgent','high','critical','overdue'].indexOf(String(ctx.record.priority).toLowerCase()) >= 0"
          }
        ],
        "defaultBranch": "normal"
      }
    },
    {
      "key": "notifyEscalation",
      "nodeID": "c2afe080-4602-4f05-b7a3-7e4ec9e63d47",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "dataQueryID": "4420a46e-e8fb-4399-aced-522e8cf2299f",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.record.ownerID }}",
          "title": "Invoices escalation",
          "body": "Record #{{ ctx.record.id }} was escalated after the response window.",
          "category": "warning",
          "linkPage": "ap-invoices-list"
        }
      }
    },
    {
      "key": "done",
      "nodeID": "8178a0dc-4d42-407b-94e9-9cfb5b5f2fb7",
      "type": "end",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "done",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 220
        },
        "outputParameters": [
          {
            "name": "result",
            "sourceVariable": "{{ ctx.record }}"
          }
        ]
      }
    }
  ],
