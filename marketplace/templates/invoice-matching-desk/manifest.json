  "features": [
    "Seeded, domain-specific data model with audit triggers",
    "Parameterized SQL queries with server-side pagination and CSV export",
    "Role-aware pages and Casbin asset permissions",
    "Workflow automations for intake, approvals, assignments and SLA sweeps",
    "In-app notification center, comments, attachments and saved views",
    "Admin screens for users, roles, audit, operations and data quality"
  ],
  "requiredIntegrations": [
    {
      "key": "erp-ap-rest",
      "title": "ERP accounts-payable REST",
      "requiredFields": [
        "base URL",
        "API token"
      ],
      "mock": "Connector ships disabled with no credentials; seeded invoices and purchase orders are the demo source of truth."
    },
    {
      "key": "supplier-invoice-webhook",
      "title": "Supplier invoice webhook",
      "requiredFields": [
        "endpoint path",
        "optional signature header"
      ],
      "mock": "POST { \"kind\": \"webhook.received\", \"record_id\": 1 } to the inactive listener to simulate a supplier invoice."
    },
    {
      "key": "ocr-document-service",
      "title": "OCR document service",
      "requiredFields": [
        "endpoint URL",
        "API key"
      ],
      "mock": "Invoice files are represented by seeded metadata and attachment URLs until an OCR provider is connected."
    }
  ],
