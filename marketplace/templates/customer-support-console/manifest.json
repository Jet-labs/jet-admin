  "features": [
    "Seeded, domain-specific data model with audit triggers",
    "Parameterized SQL queries with server-side pagination and CSV export",
    "Role-aware pages and Casbin asset permissions",
    "Workflow automations for intake, approvals, assignments and SLA sweeps",
    "In-app notification center, comments, attachments and saved views",
    "Admin screens for users, roles, audit, operations and data quality"
  ],
  "requiredIntegrations": [
    {
      "key": "webhook",
      "title": "Inbound webhook",
      "requiredFields": [
        "endpoint path",
        "signature header (optional)"
      ],
      "mock": "Send a JSON body with kind=webhook.received to the inactive listener."
    }
  ],
  "installOptions": [
    {
      "key": "includeSampleData",
      "label": "Include sample data",
      "type": "boolean",
      "default": true,
      "description": "Load the deterministic demo dataset (30-300 rows per core table)."
    },
    {
      "key": "createDemoUsers",
      "label": "Create demo staff directory",
      "type": "boolean",
      "default": false,
      "description": "Mark seeded staff as demo identities. These are not Firebase logins."
    },
    {
      "key": "enableAutomation",
      "label": "Enable cron automations",
      "type": "boolean",
      "default": false,
      "description": "Enable the packaged cron jobs. Leave off until listeners and integrations are reviewed."
    }
  ],
