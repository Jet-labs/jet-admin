{
  "slug": "support.document-generation",
  "key": "document-generation",
  "title": "Tickets · document generation",
  "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
  "tags": [
    "automation",
    "documents"
  ],
  "options": {
    "description": "Builds an HTML document from record fields, links it as an attachment and notifies the owner.",
    "inputDefinitions": [
      {
        "key": "recordID",
        "type": "number",
        "required": false,
        "defaultValue": 1
      }
    ],
    "workflowRunTimeout": 600,
    "workflowTaskTimeout": 60,
    "humanInLoopTimeout": 3600,
    "defaultNodeTimeoutSeconds": 30,
    "defaultRetryLimit": 1,
    "defaultRetryDelaySeconds": 3,
    "nodeDefaults": {
      "javascript": {
        "timeoutSeconds": 10,
        "retryLimit": 1,
        "retryDelaySeconds": 1
      },
      "dataQuery": {
        "timeoutSeconds": 30,
        "retryLimit": 1,
        "retryDelaySeconds": 2
      }
    }
  },
  "nodes": [
    {
      "key": "start",
      "nodeID": "934b6300-e5bb-4886-b633-a9c9c1331ef6",
      "type": "start",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "start",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "key": "loadRecord",
      "nodeID": "7c1cf799-0981-4275-9884-8875ac3b3c70",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "loadRecord",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 0
        },
        "dataQueryID": "72003091-8434-46cb-bb34-3f8a628d8383",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "buildDocument",
      "nodeID": "f561ee18-dd52-458a-96a1-0fb23e7abac6",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "buildDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 640,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nvar html = \"<h1>\" + String(r.subject || \"Record\") + \"</h1><p>Record #\" + String(r.id) + \"</p>\";\nreturn { fileName: \"tickets-\" + String(r.id || ctx.recordID) + \".pdf\", fileURL: \"https://files.example.invalid/customer-support-console/\" + String(r.id || ctx.recordID) + \".pdf\", mimeType: \"application/pdf\", html: html };\n",
        "outputVariable": "document"
      }
    },
    {
      "key": "linkDocument",
      "nodeID": "8a5c1390-be74-4781-b3ac-5ae07dce83dc",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "linkDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "dataQueryID": "1d1451c7-3f27-4840-9c44-27dfdca5a404",
        "outputVariable": "attachment",
        "inputValues": {
          "entity": "tickets",
          "entityID": "{{ ctx.recordID }}",
          "fileName": "{{ ctx.document.fileName }}",
          "fileURL": "{{ ctx.document.fileURL }}",
          "mimeType": "{{ ctx.document.mimeType }}",
          "uploadedBy": "{{ ctx.staffID || 1 }}"
        }
      }
    },
    {
      "key": "notifyDocument",
      "nodeID": "ceb8f32c-1acd-4138-91d6-dd4a87a24144",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyDocument",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "dataQueryID": "c887cca4-c51b-46a9-8e15-aa443eef4189",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.staffID || 1 }}",
          "title": "Tickets document ready",
          "body": "Document {{ ctx.document.fileName }} was generated for record #{{ ctx.recordID }}.",
          "category": "success",
          "linkPage": "support-tickets-detail"
        }
      }
    },
    {
      "key": "done",
      "nodeID": "3cd3b3f2-a961-4d6b-a534-8a06a105f2b4",
      "type": "end",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "done",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "outputParameters": [
          {
            "name": "result",
            "sourceVariable": "{{ ctx.document }}"
          }
        ]
      }
    }
  ],
