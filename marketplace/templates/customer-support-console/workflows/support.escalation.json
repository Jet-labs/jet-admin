        "dataQueryID": "72003091-8434-46cb-bb34-3f8a628d8383",
        "outputVariable": "recordRows",
        "inputValues": {
          "id": "{{ ctx.recordID }}"
        }
      }
    },
    {
      "key": "readPriority",
      "nodeID": "b1a1c970-bf5a-4fcb-b3e0-87acf06ef344",
      "type": "javascript",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "readPriority",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 960,
          "y": 0
        },
        "code": "\nvar r = (ctx.recordRows || [])[0] || {};\nreturn { id: r.id || ctx.recordID, priority: String(r.status || \"\"), ownerID: Number(r.assignee_id || ctx.staffID) };\n",
        "outputVariable": "record"
      }
    },
    {
      "key": "needsEscalation",
      "nodeID": "a70ea9ea-904c-4e01-a1a9-ae3d96e631df",
      "type": "condition",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "needsEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 0,
          "y": 220
        },
        "branches": [
          {
            "id": "escalate",
            "label": "Escalate",
            "condition": "['urgent','high','critical','overdue'].indexOf(String(ctx.record.priority).toLowerCase()) >= 0"
          }
        ],
        "defaultBranch": "normal"
      }
    },
    {
      "key": "notifyEscalation",
      "nodeID": "e93e2c9c-2185-4756-9699-966a193bd106",
      "type": "dataQuery",
      "timeoutSeconds": 30,
      "retryLimit": 1,
      "config": {
        "title": "notifyEscalation",
        "errorHandling": "continue",
        "joinMode": "any",
        "position": {
          "x": 320,
          "y": 220
        },
        "dataQueryID": "c887cca4-c51b-46a9-8e15-aa443eef4189",
        "outputVariable": "notification",
        "inputValues": {
          "staffID": "{{ ctx.record.ownerID }}",
          "title": "Tickets escalation",
          "body": "Record #{{ ctx.record.id }} was escalated after the response window.",
          "category": "warning",
          "linkPage": "support-tickets-list"
        }
      }
    },
