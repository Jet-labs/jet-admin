                "seats": "{{ event.formData.seats }}",
                "started_at": "{{ event.formData.started_at }}",
                "renews_at": "{{ event.formData.renews_at }}"
              },
              "successToast": "Record created",
              "errorToast": "Create failed"
            }
          }
