[
  {
    "slug": "support-tickets-calendar.heading",
    "key": "heading",
    "page": "support-tickets-calendar",
    "title": "Tickets calendar",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Tickets calendar\nMonth view keyed on **sla due at**. Select an event to inspect the record.",
      "format": "markdown"
    }
  },
  {
    "slug": "support-tickets-calendar.calendar",
    "key": "calendar",
    "page": "support-tickets-calendar",
    "title": "Calendar",
    "type": "calendar",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.tickets || {}).data || [])",
      "dateKey": "sla_due_at",
      "titleKey": "subject",
      "subtitleKey": "assignee_id",
      "groupKey": "status",
      "emptyText": "No dated records.",
      "isLoading": "{{ (state.queries.tickets || {}).isLoading || false }}",
      "events": {
        "onEventSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.event.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-tickets-calendar.selected",
    "key": "selected",
    "page": "support-tickets-calendar",
    "title": "Selected record",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Selected record",
      "dataTemplate": "{{ (((state.queries.tickets_selected || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "emptyText": "Select an event.",
      "isLoading": "{{ (state.queries.tickets_selected || {}).isLoading || false }}"
    }
  }
]
