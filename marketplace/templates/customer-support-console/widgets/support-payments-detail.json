[
  {
    "slug": "support-payments-detail.heading",
    "key": "heading",
    "page": "support-payments-detail",
    "title": "Record detail",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Payment detail\nRecord #{{ state.variables.recordID }} · every change is captured in the audit timeline.",
      "format": "markdown"
    }
  },
  {
    "slug": "support-payments-detail.status",
    "key": "status",
    "page": "support-payments-detail",
    "title": "Status",
    "type": "badge",
    "config": {
      "showHeader": false,
      "text": "{{ ((((state.queries.payments_detail || {}).data || [])[0] || {}).status) }}",
      "variant": "default"
    }
  },
  {
    "slug": "support-payments-detail.statusForm",
    "key": "statusForm",
    "page": "support-payments-detail",
    "title": "Change status",
    "type": "select",
    "config": {
      "showHeader": false,
      "label": "",
      "placeholder": "Select status",
      "defaultValue": "paid",
      "options": [
        {
          "label": "Paid",
          "value": "paid"
        },
        {
          "label": "Pending",
          "value": "pending"
        },
        {
          "label": "Failed",
          "value": "failed"
        },
        {
          "label": "Refunded",
          "value": "refunded"
        }
      ],
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "overview"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-payments-detail.statusButton",
    "key": "statusButton",
    "page": "support-payments-detail",
    "title": "Apply status",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Apply status",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "payments_status",
              "inputValues": {
                "id": "{{ state.variables.recordID }}",
                "status": "{{ (state.widgets[\"widget_25e9395e-56ba-475e-9a78-36b68f227df5_1\"] || {}).value || \"paid\" }}"
              },
              "successToast": "Status updated",
              "errorToast": "Status update failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-payments-detail.delete",
    "key": "delete",
    "page": "support-payments-detail",
    "title": "Archive",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Archive record",
      "variant": "destructive",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "payments_delete",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record archived",
              "errorToast": "Archive failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-payments-detail.restore",
    "key": "restore",
    "page": "support-payments-detail",
    "title": "Restore",
    "type": "button",
    "config": {
      "showHeader": false,
      "text": "Restore record",
      "variant": "outline",
      "events": {
        "onClick": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "payments_restore",
              "inputValues": {
                "ids": "{{ [state.variables.recordID] }}"
              },
              "successToast": "Record restored",
              "errorToast": "Restore failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-payments-detail.tabs",
    "key": "tabs",
    "page": "support-payments-detail",
    "title": "Record sections",
    "type": "tabs",
    "config": {
      "showHeader": false,
      "tabs": [
        {
          "label": "Overview",
          "value": "overview"
        },
        {
          "label": "Comments",
          "value": "comments"
        },
        {
          "label": "Attachments",
          "value": "attachments"
        },
        {
          "label": "Activity",
          "value": "activity"
        }
      ],
      "defaultTab": "overview",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.tab",
              "value": "{{ event.value }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-payments-detail.record",
    "key": "record",
    "page": "support-payments-detail",
    "title": "Record fields",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record fields",
      "dataTemplate": "{{ (((state.queries.payments_detail || {}).data || [])[0] || {}) }}",
      "columns": 2,
      "emptyText": "Record not found.",
      "isLoading": "{{ (state.queries.payments_detail || {}).isLoading || false }}"
    }
  },
  {
    "slug": "support-payments-detail.editTable",
    "key": "editTable",
    "page": "support-payments-detail",
    "title": "Inline edit",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.payments_detail || {}).data || [])",
      "columns": [
        {
          "key": "customer_id",
          "label": "Customer",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "invoice_number",
          "label": "Invoice",
          "sortable": true,
          "type": "text",
          "editable": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "sortable": true,
          "type": "number",
          "editable": true,
          "format": "0,0.00"
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "method",
          "label": "Method",
          "sortable": true,
          "type": "badge",
          "editable": true
        },
        {
          "key": "paid_at",
          "label": "Paid",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "due_date",
          "label": "Due",
          "sortable": true,
          "type": "date",
          "editable": true
        },
        {
          "key": "reference",
          "label": "Reference",
          "sortable": true,
          "type": "text",
          "editable": true
        }
      ],
      "pagination": {
        "enabled": false,
        "pageSize": 1
      },
      "search": {
        "enabled": false
      },
      "export": {
        "enabled": false
      },
      "editing": {
        "enabled": true
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No record loaded.",
      "isLoading": "{{ (state.queries.payments_detail || {}).isLoading || false }}",
      "events": {
        "onRowSave": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "payments_update",
              "inputValues": {
                "id": "{{ event.originalRow.id }}",
                "customer_id": "{{ event.updatedRow.customer_id }}",
                "invoice_number": "{{ event.updatedRow.invoice_number }}",
                "amount": "{{ event.updatedRow.amount }}",
                "status": "{{ event.updatedRow.status }}",
                "method": "{{ event.updatedRow.method }}",
                "paid_at": "{{ event.updatedRow.paid_at }}",
                "due_date": "{{ event.updatedRow.due_date }}",
                "reference": "{{ event.updatedRow.reference }}"
              },
              "successToast": "Record updated",
              "errorToast": "Update failed"
            }
          }
        ]
      }
    }
  },
