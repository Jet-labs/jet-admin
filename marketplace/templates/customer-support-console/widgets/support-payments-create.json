        {
          "key": "reference",
          "label": "Reference",
          "type": "text",
          "required": false,
          "defaultValue": "Compliance priority maintenance priority priority."
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "payments_create",
              "inputValues": {
                "customer_id": "{{ event.formData.customer_id }}",
                "invoice_number": "{{ event.formData.invoice_number }}",
                "amount": "{{ event.formData.amount }}",
                "status": "{{ event.formData.status }}",
                "method": "{{ event.formData.method }}",
                "paid_at": "{{ event.formData.paid_at }}",
                "due_date": "{{ event.formData.due_date }}",
                "reference": "{{ event.formData.reference }}"
              },
              "successToast": "Record created",
              "errorToast": "Create failed"
            }
          }
        ]
      }
    }
