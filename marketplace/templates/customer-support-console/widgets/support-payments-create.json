    "type": "json-viewer",
    "config": {
      "showHeader": true,
      "label": "Created record",
      "dataTemplate": "{{ (state.queries.payments_create || {}).data || null }}",
      "isLoading": "{{ (state.queries.payments_create || {}).isLoading || false }}"
    }
