  {
    "slug": "support-portal.table",
    "key": "table",
    "page": "support-portal",
    "title": "My records",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.portal || {}).data || [])",
      "columns": [
        {
          "key": "subject",
          "label": "Subject",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "customer_id",
          "label": "Customer",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "requester_name",
          "label": "Requester",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "priority",
          "label": "Priority",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "channel",
          "label": "Channel",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "category",
          "label": "Category",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "assignee_id",
          "label": "Assignee",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "sla_due_at",
          "label": "SLA due",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "first_response_at",
          "label": "First response",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "resolved_at",
          "label": "Resolved",
          "sortable": true,
          "type": "date",
          "editable": false
        },
        {
          "key": "satisfaction_score",
          "label": "CSAT score",
          "sortable": true,
          "type": "number",
          "editable": false
        },
        {
          "key": "description",
          "label": "Description",
          "sortable": false,
          "type": "text",
          "editable": false
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No records are assigned to this contact.",
      "isLoading": "{{ (state.queries.portal || {}).isLoading || false }}",
      "events": {
        "onRowSelect": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.selectedID",
              "value": "{{ event.row.id }}"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-portal.detail",
    "key": "detail",
    "page": "support-portal",
    "title": "Record summary",
    "type": "key-value",
    "config": {
      "showHeader": true,
      "label": "Record summary",
      "dataTemplate": "{{ (((state.queries.detail || {}).data || [])[0] || {}) }}",
      "columns": 1,
      "isLoading": "{{ (state.queries.detail || {}).isLoading || false }}"
    }
  }
]
