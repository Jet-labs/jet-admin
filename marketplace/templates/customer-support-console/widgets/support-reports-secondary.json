[
  {
    "slug": "support-reports-secondary.heading",
    "key": "heading",
    "page": "support-reports-secondary",
    "title": "Customers report",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Customers report\nCompare volume and value by status. This report uses the same parameterized query contract as the live list.",
      "format": "markdown"
    }
  },
  {
    "slug": "support-reports-secondary.range",
    "key": "range",
    "page": "support-reports-secondary",
    "title": "Date range",
    "type": "date-range-picker",
    "config": {
      "showHeader": false,
      "label": "Date range",
      "events": {
        "onChange": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": "{{ event.startDate || '' }}"
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": "{{ event.endDate || '' }}"
            }
          }
        ],
        "onClear": [
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateFrom",
              "value": ""
            }
          },
          {
            "actionType": "SET_VARIABLE",
            "config": {
              "key": "state.variables.dateTo",
              "value": ""
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-reports-secondary.total",
    "key": "total",
    "page": "support-reports-secondary",
    "title": "Records",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Records",
      "valueTemplate": "{{ ((((state.queries.second_summary || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.second_summary || {}).isLoading || false }}"
    }
  },
  {
    "slug": "support-reports-secondary.value",
    "key": "value",
    "page": "support-reports-secondary",
    "title": "Value",
    "type": "stat",
    "config": {
      "showHeader": true,
      "label": "Value",
      "prefix": "",
      "valueTemplate": "{{ ((((state.queries.second_summary || {}).data || [])[0] || {}).total) }}",
      "isLoading": "{{ (state.queries.second_summary || {}).isLoading || false }}"
    }
  },
  {
    "slug": "support-reports-secondary.status",
    "key": "status",
    "page": "support-reports-secondary",
    "title": "By status",
    "type": "vega-lite",
    "config": {
      "showHeader": true,
      "label": "By status",
      "vegaSpec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "width": "container",
        "height": "container",
        "autosize": {
          "type": "fit",
          "contains": "padding"
        },
        "data": {
          "values": "{{ (state.queries.second_status || {}).data || [] }}"
        },
        "mark": {
          "type": "bar",
          "tooltip": true
        },
        "encoding": {
          "x": {
            "field": "status",
            "type": "nominal",
            "axis": {
              "labelAngle": 0
            }
          },
          "y": {
            "field": "count",
            "type": "quantitative"
          },
          "color": {
            "field": "status",
            "type": "nominal"
          }
        }
      },
      "options": {
        "renderer": "svg",
        "showActions": false
      },
      "isLoading": "{{ (state.queries.second_status || {}).isLoading || false }}"
    }
  },
  {
    "slug": "support-reports-secondary.data",
    "key": "data",
    "page": "support-reports-secondary",
    "title": "Customers",
    "type": "table",
    "config": {
      "showHeader": true,
      "dataArrayTemplate": "((state.queries.second_list || {}).data || [])",
      "columns": [
        {
          "key": "account_name",
          "label": "Account",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "contact_name",
          "label": "Contact",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "email",
          "label": "Email",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "phone",
          "label": "Phone",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "plan",
          "label": "Plan",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "mrr",
          "label": "MRR",
          "sortable": true,
          "type": "number",
          "editable": false,
          "format": "0,0.00"
        },
        {
          "key": "status",
          "label": "Status",
          "sortable": true,
          "type": "badge",
          "editable": false
        },
        {
          "key": "owner_id",
          "label": "Account owner",
          "sortable": false,
          "type": "text",
          "editable": false
        },
        {
          "key": "region",
          "label": "Region",
          "sortable": true,
          "type": "text",
          "editable": false
        },
        {
          "key": "joined_at",
          "label": "Customer since",
          "sortable": true,
          "type": "date",
          "editable": false
        }
      ],
      "pagination": {
        "enabled": true,
        "pageSize": 10
      },
      "search": {
        "enabled": true,
        "serverSide": false
      },
      "export": {
        "enabled": true
      },
      "editing": {
        "enabled": false
      },
      "multiSelect": {
        "enabled": false
      },
      "emptyText": "No records.",
      "isLoading": "{{ (state.queries.second_list || {}).isLoading || false }}"
    }
  }
]
