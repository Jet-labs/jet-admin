[
  {
    "slug": "support-customers-create.heading",
    "key": "heading",
    "page": "support-customers-create",
    "title": "Create Customer",
    "type": "text",
    "config": {
      "showHeader": false,
      "content": "# Create Customer\nComplete the fields below. Required fields are validated before the parameterized insert query runs; the database trigger records the audit entry.",
      "format": "markdown"
    }
  },
  {
    "slug": "support-customers-create.form",
    "key": "form",
    "page": "support-customers-create",
    "title": "New Customer",
    "type": "form",
    "config": {
      "showHeader": true,
      "title": "New Customer",
      "submitLabel": "Create Customer",
      "resetLabel": "Reset",
      "layout": "grid",
      "columns": 2,
      "fields": [
        {
          "key": "account_name",
          "label": "Account",
          "type": "text",
          "required": true,
          "defaultValue": "Cedar Digital"
        },
        {
          "key": "contact_name",
          "label": "Contact",
          "type": "text",
          "required": true,
          "defaultValue": "Noah Meyer"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true,
          "defaultValue": "luca.novak.1@example.com"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "required": false,
          "defaultValue": "+1-555-961-4933"
        },
        {
          "key": "plan",
          "label": "Plan",
          "type": "select",
          "required": true,
          "defaultValue": "growth",
          "options": [
            {
              "label": "Starter",
              "value": "starter"
            },
            {
              "label": "Growth",
              "value": "growth"
            },
            {
              "label": "Scale",
              "value": "scale"
            },
            {
              "label": "Enterprise",
              "value": "enterprise"
            }
          ]
        },
        {
          "key": "mrr",
          "label": "MRR",
          "type": "number",
          "required": false,
          "defaultValue": 4079.54,
          "validation": {
            "min": 0
          }
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "defaultValue": "trial",
          "options": [
            {
              "label": "Active",
              "value": "active"
            },
            {
              "label": "Trial",
              "value": "trial"
            },
            {
              "label": "Churned",
              "value": "churned"
            }
          ]
        },
        {
          "key": "owner_id",
          "label": "Account owner",
          "type": "select",
          "required": false,
          "defaultValue": 2,
          "options": [
            {
              "label": "Noor Wright",
              "value": 1
            },
            {
