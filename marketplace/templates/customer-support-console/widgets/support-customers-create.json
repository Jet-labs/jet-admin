              "value": 6
            },
            {
              "label": "Ishaan Osei",
              "value": 7
            },
            {
              "label": "Hugo Costa",
              "value": 8
            },
            {
              "label": "Tomás Wright",
              "value": 9
            },
            {
              "label": "Sofia Meyer",
              "value": 10
