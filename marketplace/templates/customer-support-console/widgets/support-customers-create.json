            {
              "label": "Malik Fischer",
              "value": 24
            }
          ]
        },
        {
          "key": "region",
          "label": "Region",
          "type": "text",
          "required": false,
          "defaultValue": "Singapore"
        },
        {
          "key": "joined_at",
          "label": "Customer since",
          "type": "text",
          "required": false,
          "defaultValue": ""
        }
      ],
      "events": {
        "onSubmit": [
          {
            "actionType": "EXECUTE_QUERY",
            "config": {
              "alias": "customers_create",
              "inputValues": {
                "account_name": "{{ event.formData.account_name }}",
                "contact_name": "{{ event.formData.contact_name }}",
                "email": "{{ event.formData.email }}",
                "phone": "{{ event.formData.phone }}",
                "plan": "{{ event.formData.plan }}",
                "mrr": "{{ event.formData.mrr }}",
                "status": "{{ event.formData.status }}",
                "owner_id": "{{ event.formData.owner_id }}",
                "region": "{{ event.formData.region }}",
                "joined_at": "{{ event.formData.joined_at }}"
              },
              "successToast": "Record created",
              "errorToast": "Create failed"
            }
          }
        ]
      }
    }
  },
  {
    "slug": "support-customers-create.result",
    "key": "result",
    "page": "support-customers-create",
    "title": "Created record",
    "type": "json-viewer",
    "config": {
      "showHeader": true,
      "label": "Created record",
      "dataTemplate": "{{ (state.queries.customers_create || {}).data || null }}",
      "isLoading": "{{ (state.queries.customers_create || {}).isLoading || false }}"
    }
  }
]
