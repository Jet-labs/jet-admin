[
  {
    "slug": "support-record-created",
    "key": "record-created",
    "title": "Tickets · record created",
    "description": "Inbound record-created event triggers intake triage.",
    "type": "webhook",
    "datasource": "webhook",
    "endpointPath": "support-record-created",
    "status": "inactive",
    "config": {
      "pathSuffix": "support-record-created",
      "responseStatusCode": 202,
      "responseBody": "{\"accepted\":true}"
    },
    "actions": [
      {
        "actionType": "transform",
        "actionConfig": {
          "script": "var e = event && event.body ? event.body : event; if (!e || e.kind !== \"record.created\") { return null; } return e;"
        }
      },
      {
        "actionType": "trigger_workflow",
        "actionConfig": {
          "workflowID": "76bc8e0b-f55e-47d6-9798-ba70e94c5bb6",
          "inputValues": {
            "recordID": "{{ event.record_id }}",
            "staffID": "{{ event.staff_id }}",
            "event": "{{ event }}"
          }
        }
      },
      {
        "actionType": "save_to_buffer",
        "actionConfig": {
          "bufferName": "support_record-created",
          "maxRecords": 200,
          "maxAgeHours": 72,
          "retentionPolicy": "both"
        }
      }
    ]
  },
