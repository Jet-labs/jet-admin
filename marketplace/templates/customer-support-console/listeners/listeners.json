            "event": "{{ event }}"
          }
        }
      },
      {
        "actionType": "save_to_buffer",
        "actionConfig": {
          "bufferName": "support_record-created",
          "maxRecords": 200,
          "maxAgeHours": 72,
          "retentionPolicy": "both"
        }
      }
    ]
