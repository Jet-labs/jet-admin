{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jet-admin.local/schemas/marketplace-template.schema.json",
  "title": "Jet Admin Marketplace Template Package",
  "type": "object",
  "required": ["manifest", "tables", "datasources", "queries", "widgets", "pages", "workflows", "listeners", "cronJobs", "roles"],
  "properties": {
    "manifest": { "$ref": "#/definitions/manifest" },
    "tables": { "type": "array", "minItems": 8, "maxItems": 20, "items": { "type": "string" } },
    "datasources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/datasource" } },
    "queries": { "type": "array", "minItems": 30, "maxItems": 80, "items": { "$ref": "#/definitions/query" } },
    "widgets": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/widget" } },
    "pages": { "type": "array", "minItems": 12, "items": { "$ref": "#/definitions/page" } },
    "workflows": { "type": "array", "minItems": 4, "maxItems": 20, "items": { "$ref": "#/definitions/workflow" } },
    "listeners": { "type": "array", "minItems": 2, "maxItems": 15, "items": { "$ref": "#/definitions/listener" } },
    "cronJobs": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/definitions/cronJob" } },
    "roles": { "type": "array", "minItems": 4, "maxItems": 7, "items": { "$ref": "#/definitions/role" } }
  },
  "definitions": {
    "manifest": {
      "type": "object",
      "required": ["id", "slug", "name", "version", "category", "tags", "shortDescription", "longDescription", "author", "license", "minPlatformVersion", "icon", "cover", "screenshots", "features", "requiredIntegrations", "installOptions", "counts", "pages", "workflows", "roles"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "minPlatformVersion": { "type": "string" },
        "icon": { "type": "string" },
        "cover": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "object", "required": ["title", "path"] } },
        "features": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredIntegrations": { "type": "array", "items": { "type": "object" } },
        "installOptions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "label", "type", "default"] } },
        "counts": {
          "type": "object",
          "required": ["tables", "queries", "pages", "workflows", "listeners", "cronJobs", "roles", "seedRows"],
          "properties": {
            "tables": { "type": "integer" },
            "queries": { "type": "integer" },
            "pages": { "type": "integer" },
            "workflows": { "type": "integer" },
            "listeners": { "type": "integer" },
            "cronJobs": { "type": "integer" },
            "roles": { "type": "integer" },
            "seedRows": { "type": "integer" }
          }
        }
      }
    },
    "datasource": {
      "type": "object",
      "required": ["slug", "title", "type", "options"],
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string" },
        "options": { "type": "object" },
        "requiresReconnect": { "type": "boolean" }
      }
    },
    "query": {
      "type": "object",
      "required": ["slug", "title", "datasource", "tags", "options"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "title": { "type": "string" },
        "datasource": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "options": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "queryType": { "type": "string" },
            "parameterized": { "type": "boolean" },
            "inputDefinitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "type"],
                "properties": {
                  "key": { "type": "string" },
                  "type": { "enum": ["string", "number", "boolean", "array", "object"] }
                }
              }
            }
          }
        }
      }
    },
    "widget": {
      "type": "object",
      "required": ["slug", "title", "type", "config"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "page": {
      "type": "object",
      "required": ["slug", "title", "accessTags", "variables", "sources", "appPageConfig"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "accessTags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "variables": { "type": "array", "items": { "type": "object", "required": ["key"] } },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alias", "type", "queryID"],
            "properties": {
              "alias": { "type": "string" },
              "type": { "enum": ["query", "workflow", "listener"] },
              "queryID": { "type": "string" },
              "triggerMode": { "enum": ["auto", "reactive", "manual"] }
            }
          }
        },
        "appPageConfig": {
          "type": "object",
          "required": ["layoutVersion", "layout", "widgets", "variables", "dataSources"],
          "properties": {
            "layoutVersion": { "const": 2 },
            "layout": { "type": "object" },
            "widgets": { "type": "array" },
            "variables": { "type": "array" },
            "dataSources": { "type": "array" }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["slug", "title", "options", "nodes", "edges"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "options": { "type": "object" },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["nodeID", "type", "config"],
            "properties": {
              "nodeID": { "type": "string" },
              "type": {
                "enum": ["start", "end", "javascript", "dataQuery", "condition", "switch", "approval", "delay", "loop", "fanout", "join", "subWorkflow", "dataCollection"]
              },
              "config": { "type": "object" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "handle"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "handle": { "type": "string" }
            }
          }
        }
      }
    },
    "listener": {
      "type": "object",
      "required": ["slug", "title", "type", "datasource", "endpointPath", "actions"],
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string" },
        "datasource": { "type": "string" },
        "endpointPath": { "type": "string" },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["actionType", "actionConfig"] } }
      }
    },
    "cronJob": {
      "type": "object",
      "required": ["key", "title", "schedule", "workflow"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "schedule": { "type": "string" },
        "workflow": { "type": "string" }
      }
    },
    "role": {
      "type": "object",
      "required": ["key", "title", "pages", "queries", "workflows"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "pages": { "type": "array" },
        "queries": { "type": "array" },
        "workflows": { "type": "array" }
      }
    }
  }
}
