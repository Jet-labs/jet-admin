    {
      "type": "workflow",
      "id": "012da836-3082-462a-a6b9-afde0a4812e7",
      "payload": {
        "title": "Realtime Event Processor",
        "workflowOptions": {
          "inputDefinitions": [
            {
              "key": "event",
              "type": "object"
            }
          ],
          "defaultRetryLimit": 1
        },
        "nodes": [
          {
            "nodeID": "n_start",
            "nodeType": "start",
            "timeoutSeconds": 300,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Start",
              "description": "Listener event entry"
            }
          },
          {
            "nodeID": "n_parse",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Normalize event",
              "code": "var e = ctx.event || {};\nvar kind = e.kind || \"unknown\";\nvar items = [];\nif (kind === \"webhook_order\") { items = [{ label: e.orderId, value: e.total }]; }\nelse if (kind === \"wiki_change\") { items = [{ label: e.title, value: 1 }]; }\nelse if (kind === \"eth_trade\") { items = [{ label: e.symbol, value: e.notional }]; }\nelse if (kind === \"telemetry\") { var d = e.data || {}; items = Object.keys(d).map(function(k){ return { label: k, value: d[k] }; }); }\nelse { items = [{ label: \"fallback\", value: 1 }]; }\nreturn { kind: kind, items: items, highValue: (e.total > 500) || (e.notional > 1000) || false, pauseMs: 800, reviewAt: new Date(Date.now() + 1500).toISOString() };",
              "outputVariable": "norm",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_kind",
            "nodeType": "condition",
            "timeoutSeconds": 300,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Route by kind",
              "branches": [
                {
                  "id": "order",
                  "name": "Order",
                  "conditions": [
                    {
                      "leftValue": "{{ctx.norm.kind}}",
                      "operator": "equals",
                      "rightValue": "webhook_order"
                    }
                  ],
                  "conditionLogic": "AND"
                },
                {
                  "id": "trade",
                  "name": "Trade",
                  "conditionType": "expression",
                  "expression": "ctx.norm && ctx.norm.kind === 'eth_trade'"
                },
                {
                  "id": "wiki",
                  "name": "Wiki",
                  "conditionType": "expression",
                  "expression": "ctx.norm && ctx.norm.kind === 'wiki_change'"
                }
              ],
              "evaluationMode": "first_match",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_order_enrich",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Enrich coin",
              "dataQueryID": "1c5dd216-528f-453b-b533-868319f0ad33",
              "inputValues": {
                "ids": "ethereum"
              },
              "outputVariable": "enrich",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_order_msg",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Order message",
              "code": "var n = ctx.norm || {};\nreturn 'ORDER ' + n.kind + ' items=' + n.items.length + ' high=' + n.highValue;",
              "outputVariable": "msg",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_trade_msg",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Trade message",
              "code": "var n = ctx.norm || {};\nreturn 'TRADE items=' + JSON.stringify(n.items).slice(0, 200);",
              "outputVariable": "msg",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_wiki_msg",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Wiki message",
              "code": "var n = ctx.norm || {};\nreturn 'WIKI ' + (n.items[0] ? n.items[0].label : 'unknown');",
              "outputVariable": "msg",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_other_msg",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Other message",
              "code": "return 'OTHER kind=' + ((ctx.norm && ctx.norm.kind) || 'unknown');",
              "outputVariable": "msg",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_gate",
            "nodeType": "condition",
            "timeoutSeconds": 300,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "High value?",
              "branches": [
                {
                  "id": "hot",
                  "name": "Hot",
                  "conditionType": "expression",
                  "expression": "ctx.norm && ctx.norm.highValue === true"
                }
              ],
              "evaluationMode": "first_match",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_pause",
            "nodeType": "delay",
