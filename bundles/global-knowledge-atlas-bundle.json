    {
      "type": "workflow",
      "id": "74d9ad26-ae25-4793-ad5c-7f522d2dc3a9",
      "payload": {
        "title": "Global Knowledge Atlas",
        "workflowOptions": {
          "inputDefinitions": [
            {
              "key": "name",
              "type": "string"
            },
            {
              "key": "q",
              "type": "string"
            },
            {
              "key": "zip",
              "type": "string"
            },
            {
              "key": "owner",
              "type": "string"
            },
            {
              "key": "repo",
              "type": "string"
            },
            {
              "key": "countryCode",
              "type": "string"
            }
          ],
          "defaultRetryLimit": 1,
          "defaultNodeTimeoutSeconds": 60
        },
        "nodes": [
          {
            "nodeID": "n_start",
            "nodeType": "start",
            "timeoutSeconds": 300,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Start",
              "description": "Atlas entry"
            }
          },
          {
            "nodeID": "n_books",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Search books",
              "dataQueryID": "1d03be57-1a5d-4404-8bf6-b4ab02da4b9c",
              "inputValues": {
                "q": "{{ctx.q}}",
                "limit": 6
              },
              "outputVariable": "books",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_age",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Guess age",
              "dataQueryID": "63d803cc-95a9-4ae7-bdb4-3a127fb8b49e",
              "inputValues": {
                "name": "{{ctx.name}}"
              },
              "outputVariable": "age",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_gender",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Guess gender",
              "dataQueryID": "0eaba168-9901-4901-88d7-e4426fb2748a",
              "inputValues": {
                "name": "{{ctx.name}}"
              },
              "outputVariable": "gender",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_cat",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Cat fact",
              "dataQueryID": "488663ba-19ea-44d9-b221-76ca06422c09",
              "inputValues": {},
              "outputVariable": "catFact",
              "errorHandling": "continue_default"
            }
          },
          {
            "nodeID": "n_join",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Join person context",
              "code": "var books = ctx.books || {};\nvar docs = books.docs || [];\nvar titles = docs.slice(0, 6).map(function(d){ return d.title; });\nvar age = ctx.age || {};\nvar gender = ctx.gender || {};\nvar cat = ctx.catFact || {};\nreturn { titles: titles, bookCount: books.numFound || 0, age: Number(age.age) || null, ageCount: age.count || 0, gender: gender.gender || null, genderProb: gender.probability || null, catFact: cat.fact || null, joinedAt: new Date().toISOString(), coolMs: 1200, followUpAt: new Date(Date.now() + 2000).toISOString() };",
              "outputVariable": "person",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_nat",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Guess nationality",
              "dataQueryID": "a1fd67b2-cb00-4946-86f2-a7d9428c4fa2",
              "inputValues": {
                "name": "{{ctx.name}}"
              },
              "outputVariable": "nat",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_zip",
            "nodeType": "dataQuery",
            "timeoutSeconds": 60,
            "retryLimit": 1,
            "nodeConfig": {
              "title": "Lookup zip",
              "dataQueryID": "e7646b55-749c-4e3c-9eb2-53662561150c",
              "inputValues": {
                "zip": "{{ctx.zip}}"
              },
              "outputVariable": "zipInfo",
              "errorHandling": "continue"
            }
          },
          {
            "nodeID": "n_enrich",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Enrich person",
              "code": "var p = ctx.person || {};\nvar nat = ctx.nat || {};\nvar countries = nat.country || [];\nvar top = countries.length ? countries[0].country_id : null;\nvar zip = ctx.zipInfo || {};\nvar places = zip.places || [];\np.name = ctx.name;\np.topCountry = top;\np.zipPlace = places.length ? places[0]['place name'] : null;\np.zipState = places.length ? places[0].state : null;\nreturn p;",
              "outputVariable": "person",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_check_age",
            "nodeType": "condition",
            "timeoutSeconds": 300,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Age band",
              "branches": [
                {
                  "id": "senior",
                  "name": "Senior",
                  "conditions": [
                    {
                      "leftValue": "{{ctx.person.age}}",
                      "operator": "greater_than",
                      "rightValue": "50"
                    }
                  ],
                  "conditionLogic": "AND"
                },
                {
                  "id": "young",
                  "name": "Young",
                  "conditionType": "expression",
                  "expression": "ctx.person && ctx.person.age != null && ctx.person.age < 30"
                }
              ],
              "evaluationMode": "first_match",
              "errorHandling": "fail_workflow"
            }
          },
          {
            "nodeID": "n_profile",
            "nodeType": "javascript",
            "timeoutSeconds": 30,
            "retryLimit": 0,
            "nodeConfig": {
              "title": "Build profile line",
