    {
      "type": "dataQuery",
      "id": "22222222-2222-4222-8222-222222222222",
      "payload": {
        "dataQueryTitle": "Pagila — Film List (paged)",
        "dataQueryDescription": "Server-paginated film grid with title search, rating, category and min-length filters.",
        "datasourceType": "postgresql",
        "runOnLoad": false,
        "dataQueryOptions": {
          "queryType": "query",
          "query": "SELECT f.film_id, f.title, f.release_year, f.rating, f.rental_rate, f.length, f.rental_duration, f.replacement_cost, f.last_update, c.name AS category, TRIM(l.name) AS language FROM film f LEFT JOIN film_category fc ON fc.film_id = f.film_id LEFT JOIN category c ON c.category_id = fc.category_id JOIN language l ON l.language_id = f.language_id WHERE ('' = '{{ inputs.search }}' OR f.title ILIKE '%{{ inputs.search }}%' OR f.description ILIKE '%{{ inputs.search }}%') AND ('All' = '{{ inputs.rating }}' OR f.rating::text = '{{ inputs.rating }}') AND ('All Categories' = '{{ inputs.category }}' OR c.name = '{{ inputs.category }}') AND f.length >= {{ inputs.min_length }} ORDER BY f.title ASC LIMIT {{ inputs.pageSize }} OFFSET ({{ inputs.page }} - 1) * {{ inputs.pageSize }};",
          "inputDefinitions": [
            { "key": "page", "type": "number", "required": false, "default": 1 },
            { "key": "pageSize", "type": "number", "required": false, "default": 10 },
            { "key": "search", "type": "string", "required": false, "default": "" },
            { "key": "rating", "type": "string", "required": false, "default": "All" },
            { "key": "category", "type": "string", "required": false, "default": "All Categories" },
            { "key": "min_length", "type": "number", "required": false, "default": 0 }
          ]
        }
      },
      "dependencies": [
        { "type": "datasource", "id": "11111111-1111-4111-8111-111111111111", "name": "PagilaDb", "bundled": true }
      ]
    },
    {
