              "code": "var rows = ctx.rows || (ctx.input && ctx.input.rows) || []; var ids = rows.map(function (r) { return Number(r.film_id); }).filter(function (n) { return n > 0; }); var action = ctx.action || (ctx.input && ctx.input.action) || ''; return { film_ids: ids.length ? ids : [-1], action: action };",
