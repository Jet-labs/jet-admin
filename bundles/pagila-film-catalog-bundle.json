    {
      "type": "dataQuery",
      "id": "aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa",
      "payload": {
        "dataQueryTitle": "Pagila — Bulk Update Films",
        "dataQueryDescription": "Bulk workflow target: discount or extend rental duration for many films at once.",
        "datasourceType": "postgresql",
        "runOnLoad": false,
        "dataQueryOptions": {
          "queryType": "query",
          "query": "UPDATE film SET rental_rate = CASE WHEN '{{ inputs.action }}' = 'discount_10' THEN ROUND((rental_rate * 0.9)::numeric, 2) ELSE rental_rate END, rental_duration = CASE WHEN '{{ inputs.action }}' = 'extend_rental' THEN rental_duration + 2 ELSE rental_duration END, last_update = NOW() WHERE film_id IN ({{ inputs.film_ids }}) RETURNING film_id;",
          "inputDefinitions": [
            { "key": "film_ids", "type": "array", "required": true },
            { "key": "action", "type": "string", "required": true }
          ]
        }
      },
      "dependencies": [
        { "type": "datasource", "id": "11111111-1111-4111-8111-111111111111", "name": "PagilaDb", "bundled": true }
      ]
    },
    {
      "type": "workflow",
