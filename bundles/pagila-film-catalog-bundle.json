            "onPageChange": [
              { "actionType": "SET_VARIABLE", "config": { "key": "state.variables.page", "value": "{{ event.page }}" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films" } }
            ],
            "onSearch": [
              { "actionType": "SET_VARIABLE", "config": { "key": "state.variables.search", "value": "{{ event.searchTerm }}" } },
              { "actionType": "SET_VARIABLE", "config": { "key": "state.variables.page", "value": 1 } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films_count" } }
            ],
            "onRowSelect": [
              { "actionType": "SET_VARIABLE", "config": { "key": "state.variables.selected_film_id", "value": "{{ event.row.film_id }}" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "film_detail" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "related_films" } }
            ],
            "onRowSave": [
              { "actionType": "TRIGGER_QUERY", "config": { "queryID": "99999999-9999-4999-8999-999999999999", "inputValues": { "film_id": "{{ event.originalRow.film_id }}", "title": "{{ event.updatedRow.title }}", "rental_rate": "{{ event.updatedRow.rental_rate }}" } } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "film_detail" } },
              { "actionType": "SHOW_TOAST", "config": { "message": "Film {{ event.originalRow.film_id }} saved", "variant": "success" } }
            ],
            "onBulkAction": [
              { "actionType": "TRIGGER_WORKFLOW", "config": { "workflowID": "b0000000-0000-4000-8000-000000000000", "inputValues": { "rows": "{{ event.selectedRows }}", "action": "{{ event.actionKey }}" } } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films" } },
              { "actionType": "EXECUTE_QUERY", "config": { "alias": "films_count" } },
              { "actionType": "SHOW_TOAST", "config": { "message": "Bulk update started — grid will refresh", "variant": "success" } }
            ],
            "onBulkDelete": [
              { "actionType": "SHOW_TOAST", "config": { "message": "Deletes are disabled in this demo — use a bulk action instead", "variant": "error" } }
            ],
            "onBulkExport": [
              { "actionType": "SHOW_TOAST", "config": { "message": "{{ event.selectedRows.length }} selected rows ready — use Export for the CSV file", "variant": "success" } }
            ],
            "onExport": [
              { "actionType": "SHOW_TOAST", "config": { "message": "Exported {{ event.rowCount }} rows as {{ event.format }}", "variant": "success" } }
            ]
          }
        },
        "refreshInterval": null
      },
