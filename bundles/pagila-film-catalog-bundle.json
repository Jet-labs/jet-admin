    {
      "type": "dataQuery",
      "id": "77777777-7777-4777-8777-777777777777",
      "payload": {
        "dataQueryTitle": "Pagila — Related Films",
        "dataQueryDescription": "10 longest films sharing a category with the selected film (detail feed).",
        "datasourceType": "postgresql",
        "runOnLoad": false,
        "dataQueryOptions": {
          "queryType": "query",
          "query": "SELECT f2.title AS title, f2.release_year AS time, (COALESCE(c2.name, 'Uncategorised') || ' • ' || f2.rating::text || ' • ' || f2.length || ' min • $' || f2.rental_rate) AS description FROM film f2 LEFT JOIN film_category fc2 ON fc2.film_id = f2.film_id LEFT JOIN category c2 ON c2.category_id = fc2.category_id WHERE f2.film_id <> {{ inputs.film_id }} AND fc2.category_id IN (SELECT category_id FROM film_category WHERE film_id = {{ inputs.film_id }}) ORDER BY f2.length DESC LIMIT 10;",
          "inputDefinitions": [
            { "key": "film_id", "type": "number", "required": false, "default": -1 }
          ]
        }
      },
      "dependencies": [
        { "type": "datasource", "id": "11111111-1111-4111-8111-111111111111", "name": "PagilaDb", "bundled": true }
      ]
    },
    {
      "type": "dataQuery",
      "id": "88888888-8888-4888-8888-888888888888",
      "payload": {
        "dataQueryTitle": "Pagila — Films by Category",
        "dataQueryDescription": "Bar chart data: film count per category.",
        "datasourceType": "postgresql",
        "runOnLoad": false,
        "dataQueryOptions": {
          "queryType": "query",
          "query": "SELECT c.name AS category, COUNT(fc.film_id)::int AS films FROM category c JOIN film_category fc ON fc.category_id = c.category_id GROUP BY c.name ORDER BY films DESC;",
