      "id": "66666666-6666-4666-8666-666666666666",
      "payload": {
        "dataQueryTitle": "Pagila — Film Detail",
        "dataQueryDescription": "Single film record for the detail panel (reactive on selected_film_id).",
        "datasourceType": "postgresql",
        "runOnLoad": false,
        "dataQueryOptions": {
          "queryType": "query",
          "query": "SELECT f.film_id, f.title, f.description, f.release_year, f.rating, f.rental_rate, f.length, f.rental_duration, f.replacement_cost, f.last_update, TRIM(l.name) AS language, c.name AS category FROM film f JOIN language l ON l.language_id = f.language_id LEFT JOIN film_category fc ON fc.film_id = f.film_id LEFT JOIN category c ON c.category_id = fc.category_id WHERE f.film_id = {{ inputs.film_id }};",
          "inputDefinitions": [
            { "key": "film_id", "type": "number", "required": false, "default": -1 }
          ]
        }
      },
