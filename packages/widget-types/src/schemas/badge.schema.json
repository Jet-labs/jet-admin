{
  "widgetType": "badge",
  "description": "Badge / Tag widget. Status pill with template-driven text and variant mapping.",
  "schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Badge text. Supports templates."
      },
      "variant": {
        "type": "string",
        "enum": [
          "default",
          "secondary",
          "success",
          "warning",
          "destructive",
          "outline"
        ],
        "default": "default"
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "default",
          "lg"
        ],
        "default": "default"
      },
      "isLoading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.q.isLoading }})."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad"
  ]
}
