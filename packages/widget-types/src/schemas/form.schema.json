{
  "widgetType": "form",
  "description": "Form widget. Renders an input form with configurable fields and submit action. Draft values/errors/dirty/submitting are exposed in widget state; untouched fields keep defaults on refresh while dirty edits are preserved.",
  "schema": {
    "type": "object",
    "properties": {
      "fields": {
        "type": "array",
        "description": "Form field definitions",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Field key (used as form data property name)"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text",
                "number",
                "email",
                "password",
                "textarea",
                "select",
                "multiselect",
                "checkbox",
                "radio",
                "date",
                "datetime",
                "file",
                "hidden"
              ],
              "default": "text"
            },
            "placeholder": {
              "type": "string"
            },
            "help": {
              "type": "string",
              "description": "Help text shown under the field, associated via aria-describedby."
            },
            "defaultValue": {
              "description": "Default value for the field"
            },
            "required": {
              "type": "boolean",
              "default": false
            },
            "disabled": {
              "type": [
                "boolean",
                "string"
              ],
              "default": false
            },
            "readOnly": {
              "type": [
                "boolean",
                "string"
              ],
              "default": false,
              "description": "Read-only: focusable but not editable (distinct from disabled)."
            },
            "rows": {
              "type": "number",
              "description": "Visible rows for textarea fields."
            },
            "maxLength": {
              "type": "number",
              "description": "Maximum character length (shorthand for validation.maxLength)."
            },
            "options": {
              "type": "array",
              "description": "Options for select/radio/multiselect fields",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {}
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "validation": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minLength": {
                  "type": "number"
                },
                "maxLength": {
                  "type": "number"
                },
                "pattern": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "key",
            "label",
            "type"
          ]
        }
      },
      "submitLabel": {
        "type": "string",
        "default": "Submit"
      },
      "resetLabel": {
        "type": "string",
        "description": "Label for reset button; empty hides it. Setting a non-empty resetLabel implies showReset."
      },
      "layout": {
        "type": "string",
        "enum": [
          "vertical",
          "horizontal",
          "grid"
        ],
        "default": "vertical",
        "description": "Field arrangement: vertical stack, wrapped horizontal row, or grid with columns."
      },
      "columns": {
        "type": "number",
        "description": "Number of columns when layout is 'grid' (1-4, clamps; narrow containers wrap).",
        "default": 2
      },
      "isLoading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.q.isLoading }})."
      },
      "size": {
        "type": "string",
        "enum": [
          "default",
          "sm",
          "lg"
        ],
        "default": "default",
        "description": "Form density/size: sm compact, default comfortable, lg spacious."
      },
      "showReset": {
        "type": "boolean",
        "default": false,
        "description": "Show the reset control (canonical; derived from resetLabel when unset)."
      }
    },
    "required": [
      "fields"
    ]
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad",
    "onSubmit",
    "onFieldChange",
    "onReset"
  ]
}
