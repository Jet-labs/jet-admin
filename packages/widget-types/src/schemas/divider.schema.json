{
  "widgetType": "divider",
  "description": "Divider / Spacer widget. Visual separator with optional label for section grouping.",
  "schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "description": "Optional centered label"
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal"
      },
      "thickness": {
        "type": "string",
        "enum": [
          "thin",
          "medium",
          "thick"
        ],
        "default": "thin"
      },
      "spacing": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ],
        "default": "md"
      },
      "isLoading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.q.isLoading }})."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad"
  ]
}
