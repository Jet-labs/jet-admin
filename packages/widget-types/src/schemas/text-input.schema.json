{
  "widgetType": "text-input",
  "description": "Text Input widget. Single-line or multi-line user text entry with template default value. Writes its value to widget state for use in queries.",
  "schema": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "description": "Input label" },
      "placeholder": { "type": "string" },
      "inputType": { "type": "string", "enum": ["text", "number", "email", "password", "url", "textarea"], "default": "text" },
      "defaultValue": { "type": "string", "description": "Default value. Supports template expressions." },
      "required": { "type": "boolean", "default": false },
      "disabled": { "type": ["boolean", "string"], "default": false },
      "maxLength": { "type": "number", "description": "Maximum character length" },
      "rows": { "type": "number", "default": 3, "description": "Visible rows when inputType is textarea" }
    }
  },
  "events": ["onClick", "onRefresh", "onLoad", "onChange", "onFocus", "onBlur", "onClear"]
}
