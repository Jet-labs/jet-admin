{
  "widgetType": "text-input",
  "description": "Text Input widget. Single-line or multi-line user text entry with template default value. Writes its value to widget state for use in queries.",
  "schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "description": "Input label"
      },
      "placeholder": {
        "type": "string"
      },
      "inputType": {
        "type": "string",
        "enum": [
          "text",
          "number",
          "email",
          "password",
          "url",
          "textarea"
        ],
        "default": "text"
      },
      "defaultValue": {
        "type": "string",
        "description": "Default value. Supports template expressions."
      },
      "required": {
        "type": "boolean",
        "default": false
      },
      "disabled": {
        "type": [
          "boolean",
          "string"
        ],
        "default": false
      },
      "maxLength": {
        "type": "number",
        "description": "Maximum character length"
      },
      "rows": {
        "type": "number",
        "default": 3,
        "description": "Visible rows when inputType is textarea"
      },
      "labelPosition": {
        "type": "string",
        "enum": ["top", "left", "hidden"],
        "default": "top"
      },
      "size": {
        "type": "string",
        "enum": ["sm", "default", "lg"],
        "default": "default"
      },
      "variant": {
        "type": "string",
        "enum": ["outline", "filled", "underline"],
        "default": "outline"
      },
      "prefix": {
        "type": "string"
      },
      "suffix": {
        "type": "string"
      },
      "help": {
        "type": "string"
      },
      "mask": {
        "type": "string",
        "description": "Input mask: 9 = digit, A = letter, * = letter or digit."
      },
      "readOnly": {
        "type": ["boolean", "string"],
        "default": false
      },
      "minLength": {
        "type": "number"
      },
      "pattern": {
        "type": "string"
      },
      "errorMessage": {
        "type": "string"
      },
      "validateOn": {
        "type": "string",
        "enum": ["change", "blur", "submit"],
        "default": "blur"
      },
      "showCount": {
        "type": "boolean",
        "default": false
      },
      "autosize": {
        "type": "boolean",
        "default": false
      },
      "allowPasswordReveal": {
        "type": "boolean",
        "default": true
      },
      "autoComplete": {
        "type": "string"
      },
      "isLoading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.q.isLoading }})."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad",
    "onChange",
    "onFocus",
    "onBlur",
    "onClear"
  ]
}
