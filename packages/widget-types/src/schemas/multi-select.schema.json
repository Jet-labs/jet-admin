{
  "widgetType": "multi-select",
  "description": "Multi-Select widget. Pick zero or more options. Writes an array of selected values to widget state.",
  "schema": {
    "type": "object",
    "properties": {
      "label": { "type": "string" },
      "placeholder": { "type": "string", "default": "Select options..." },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "value": { "type": ["string", "number", "boolean"] }
          },
          "required": ["label", "value"]
        }
      },
      "optionsTemplate": { "type": "string", "description": "Template resolving to an options array" },
      "labelKey": { "type": "string", "default": "label" },
      "valueKey": { "type": "string", "default": "value" },
      "defaultValue": { "type": "array", "description": "Default selected values array" },
      "maxSelected": { "type": "number", "description": "Maximum selectable options" },
      "disabled": { "type": ["boolean", "string"], "default": false }
    }
  },
  "events": ["onClick", "onRefresh", "onLoad", "onChange", "onClear"]
}
