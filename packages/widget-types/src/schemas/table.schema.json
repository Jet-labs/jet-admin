{
  "widgetType": "table",
  "description": "Data table widget. Displays rows of data with configurable columns, sorting, pagination, search, export, selection and inline editing. Supports nested field paths (e.g. user.name).",
  "schema": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "description": "Column definitions for the table",
        "items": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "description": "Data field key (legacy alias of key). Supports nested paths like user.name"
            },
            "key": {
              "type": "string",
              "description": "Data field key. Supports nested paths like user.name"
            },
            "id": {
              "type": "string",
              "description": "Column id (defaults to key)"
            },
            "title": {
              "type": "string",
              "description": "Column header label (legacy alias of label)"
            },
            "label": {
              "type": "string",
              "description": "Column header label"
            },
            "type": {
              "type": "string",
              "enum": [
                "text",
                "number",
                "boolean",
                "date",
                "link",
                "image",
                "badge"
              ],
              "default": "text",
              "description": "Column render type"
            },
            "width": {
              "type": [
                "number",
                "string"
              ],
              "description": "Column width in px"
            },
            "sortable": {
              "type": "boolean",
              "default": true,
              "description": "Enable click-to-sort on this column"
            },
            "filterable": {
              "type": "boolean",
              "default": false
            },
            "editable": {
              "type": "boolean",
              "default": false
            },
            "hidden": {
              "type": "boolean",
              "default": false,
              "description": "Hide column without deleting its config"
            },
            "format": {
              "type": "string",
              "description": "Display override (e.g. link label text)"
            },
            "align": {
              "type": "string",
              "enum": ["left", "center", "right"]
            },
            "decimals": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            }
          }
        }
      },
      "pagination": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable server-side pagination (fires onPageChange). Client-side paging is automatic when rows exceed pageSize."
          },
          "pageSize": {
            "type": "number",
            "default": 10,
            "description": "Rows per page (1-500)"
          },
          "mode": {
            "type": "string",
            "enum": ["client", "server"],
            "default": "client"
          },
          "pageParam": {
            "type": "string",
            "default": "page"
          },
          "pageSizeParam": {
            "type": "string",
            "default": "limit"
          },
          "totalTemplate": {
            "type": [
              "string",
              "number"
            ],
            "description": "Template resolving to total row count for server pagination"
          },
          "totalRows": {
            "type": "number",
            "description": "Resolved total row count (set by runtime)"
          }
        }
      },
      "searchable": {
        "type": "boolean",
        "default": false,
        "description": "Legacy alias — use search.enabled"
      },
      "search": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "serverSide": {
            "type": "boolean",
            "default": false
          },
          "placeholder": {
            "type": "string",
            "default": "Search..."
          }
        }
      },
      "exportable": {
        "type": "boolean",
        "default": false,
        "description": "Legacy alias — use export.enabled"
      },
      "export": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json"
            ],
            "default": "csv"
          },
          "serverSide": {
            "type": "boolean",
            "default": false
          },
          "buttonLabel": {
            "type": "string",
            "default": "Export"
          },
          "scope": {
            "type": "string",
            "enum": ["filtered", "page", "selected", "all"],
            "default": "filtered"
          }
        }
      },
      "selectable": {
        "type": "boolean",
        "default": false,
        "description": "Legacy alias — use multiSelect.enabled"
      },
      "multiSelect": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "showSelectAll": {
            "type": "boolean",
            "default": true
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "actionKey": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "variant": {
                  "type": "string",
                  "enum": [
                    "default",
                    "danger",
                    "destructive",
                    "outline",
                    "success"
                  ]
                }
              }
            }
          }
        }
      },
      "editing": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "bulkEdit": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "saveLabel": {
            "type": "string"
          }
        }
      },
      "bulkActions": {
        "type": "array",
        "description": "Legacy alias — use multiSelect.actions",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "variant": {
              "type": "string",
              "enum": [
                "default",
                "danger",
                "success"
              ]
            }
          },
          "required": [
            "key",
            "label"
          ]
        }
      },
      "emptyText": {
        "type": "string",
        "description": "Text to show when table has no data"
      },
      "emptyHint": {
        "type": "string",
        "description": "Helper line under the empty state"
      },
      "striped": {
        "type": "boolean",
        "default": true,
        "description": "Zebra-strip rows"
      },
      "dense": {
        "type": "boolean",
        "default": false,
        "description": "Compact row padding"
      },
      "stickyHeader": {
        "type": "boolean",
        "default": true,
        "description": "Keep header visible while scrolling"
      },
      "isLoading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.q.isLoading }})."
      },
      "loadingText": {
        "type": "string",
        "default": "Updating...",
        "description": "Text shown in the loading overlay for refreshes and initial loads."
      },
      "searchingText": {
        "type": "string",
        "default": "Searching...",
        "description": "Text shown in the loading overlay while a server-side search is running."
      },
      "rowKey": {
        "type": "string",
        "default": "id",
        "description": "Preferred stable row identifier field."
      },
      "hoverHighlight": {
        "type": "boolean",
        "default": true
      },
      "noResultsText": {
        "type": "string",
        "default": "No rows match the current filters."
      },
      "dataArrayTemplate": {
        "type": "string",
        "description": "Template resolving to the row array, e.g. '{{ state.queries.orders.data }}'. Canonical data binding field."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad",
    "onRowSelect",
    "onPageChange",
    "onSearch",
    "onExport",
    "onRowSave",
    "onBulkDelete",
    "onBulkExport",
    "onBulkAction",
    "onBulkEdit"
  ]
}
