{
  "widgetType": "vega-lite",
  "description": "Vega-Lite chart widget. Canonical binding field is vegaSpec (spec accepted as a legacy alias and mirrored on save). Bind data via vegaSpec.data.values using {{ state.queries.<alias>.data }}.",
  "schema": {
    "type": "object",
    "properties": {
      "spec": {
        "type": "object",
        "description": "Vega-Lite JSON specification (https://vega.github.io/vega-lite/docs/spec.html). Set data.values to '{{ state.queries.<alias>.data }}' for live binding.",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "mark": {
            "description": "Mark type: bar, line, point, area, arc, rect, rule, text, tick, trail, circle, square, geoshape, boxplot, errorband, errorbar"
          },
          "encoding": {
            "type": "object"
          },
          "data": {
            "type": "object",
            "description": "Use { values: '{{ state.queries.<alias>.data }}' }"
          },
          "transform": {
            "type": "array"
          },
          "width": {
            "type": [
              "number",
              "string"
            ]
          },
          "height": {
            "type": [
              "number",
              "string"
            ]
          },
          "title": {
            "type": [
              "string",
              "object"
            ]
          },
          "config": {
            "type": "object"
          }
        }
      },
      "vegaSpec": {
        "type": "object",
        "description": "Runtime Vega-Lite spec used by production pages (same shape as spec). Must include data.values bound to '{{ state.queries.<alias>.data }}'.",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "mark": {
            "type": "object"
          },
          "encoding": {
            "type": "object"
          },
          "data": {
            "type": "object"
          },
          "width": {
            "type": [
              "number",
              "string"
            ]
          },
          "height": {
            "type": [
              "number",
              "string"
            ]
          },
          "autosize": {
            "type": "object"
          }
        }
      },
      "options": {
        "type": "object",
        "description": "Runtime options wrapper (alternative to top-level showActions/renderer).",
        "properties": {
          "renderer": {
            "type": "string",
            "enum": [
              "svg",
              "canvas"
            ],
            "default": "svg"
          },
          "showActions": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "showHeader": {
        "type": "boolean",
        "default": true
      },
      "isLoading": {
        "type": "string",
        "description": "Template, e.g. '{{ state.queries.<alias>.isLoading }}'"
      },
      "showActions": {
        "type": "boolean",
        "title": "Show Actions",
        "description": "Show Vega embed action buttons",
        "default": false
      },
      "renderer": {
        "type": "string",
        "title": "Renderer",
        "enum": [
          "svg",
          "canvas"
        ],
        "description": "Rendering engine for the chart",
        "default": "svg"
      },
      "theme": {
        "type": "string",
        "description": "Theme name consumed by the shared Vega renderer."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad",
    "onMarkClick",
    "onBrush",
    "onRenderError"
  ]
}
