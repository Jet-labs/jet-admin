{
  "widgetType": "button",
  "description": "Button widget. A clickable button that triggers an action.",
  "schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Button text. Supports template expressions. Legacy alias: label.",
        "default": "Click Me"
      },
      "label": {
        "type": "string",
        "description": "Legacy alias of text (frontend renders text ?? label)."
      },
      "variant": {
        "type": "string",
        "enum": [
          "default",
          "secondary",
          "green",
          "destructive",
          "white",
          "outline",
          "ghost",
          "link",
          "pill",
          "primary-ghost",
          "destructive-ghost",
          "primary-outline"
        ],
        "default": "default",
        "description": "Visual style variant (matches @jet-admin/ui Button)"
      },
      "size": {
        "type": "string",
        "enum": [
          "default",
          "sm",
          "lg",
          "icon",
          "circle",
          "pill"
        ],
        "default": "default",
        "description": "Button size (matches @jet-admin/ui Button)"
      },
      "icon": {
        "type": "string",
        "description": "Optional icon name (play, plus, download, upload, trash, edit, save, search, refresh, arrowRight, check, close, filter, settings, chevronDown)"
      },
      "iconPosition": {
        "type": "string",
        "enum": [
          "left",
          "right"
        ],
        "default": "left"
      },
      "alignment": {
        "type": "string",
        "enum": [
          "left",
          "center",
          "right"
        ],
        "default": "center",
        "description": "Horizontal alignment of the button in its row"
      },
      "fullWidth": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Stretch button to fill the row width",
        "default": false
      },
      "disabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Disabled state — boolean or template expression"
      },
      "isLoading": {
        "type": [
          "string",
          "boolean"
        ],
        "description": "Loading overlay — boolean or template expression (e.g. {{ state.queries.myQuery.isLoading }}). Legacy alias: loading."
      },
      "tooltip": {
        "type": "string",
        "description": "Hover/focus tooltip. Supports template expressions."
      },
      "loadingText": {
        "type": "string"
      },
      "successText": {
        "type": "string"
      },
      "shortcut": {
        "type": "string",
        "description": "Keyboard shortcut, e.g. Ctrl+Enter."
      },
      "confirm": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "confirmLabel": { "type": "string" },
          "cancelLabel": { "type": "string" }
        }
      },
      "loading": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Legacy alias of isLoading."
      }
    }
  },
  "events": [
    "onClick",
    "onRefresh",
    "onLoad",
    "onSubmit"
  ]
}
