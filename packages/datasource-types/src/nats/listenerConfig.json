    "properties": {
      "subjects": { "type": "string", "description": "Comma-separated NATS subjects to subscribe to (supports wildcards: * and >)" },
      "queueGroup": { "type": "string", "description": "Optional queue group for load balancing" }
    },
    "required": ["subjects"]
  },
  "uischema": {
    "type": "VerticalLayout",
