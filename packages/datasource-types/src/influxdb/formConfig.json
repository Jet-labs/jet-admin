{
  "schema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "InfluxDB base URL (e.g. http://localhost:8086).",
        "format": "uri",
        "default": "http://localhost:8086"
      },
      "org": {
        "type": "string",
        "description": "InfluxDB organization.",
        "default": "jet-admin"
      },
      "bucket": {
        "type": "string",
        "description": "Default bucket for writes (queries can override).",
        "default": "metrics"
      },
      "token": {
        "type": "string",
        "description": "InfluxDB API token (v2).",
        "format": "password"
      },
      "timeout": {
        "type": "integer",
        "description": "Request timeout in seconds.",
        "minimum": 1,
        "default": 15
      }
    },
    "required": ["baseUrl", "token"]
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/baseUrl",
        "label": "Base URL"
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/org",
            "label": "Organization"
          },
          {
            "type": "Control",
            "scope": "#/properties/bucket",
            "label": "Default Bucket"
          }
        ]
      },
      {
        "type": "HorizontalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/token",
            "label": "API Token",
            "options": { "format": "password" }
          },
          {
            "type": "Control",
            "scope": "#/properties/timeout",
            "label": "Timeout (seconds)"
          }
        ]
      }
    ]
  },
  "data": {
    "baseUrl": "http://localhost:8086",
    "org": "jet-admin",
    "bucket": "metrics",
    "token": "",
    "timeout": 15
  }
}
