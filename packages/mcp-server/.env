# Jet Admin MCP Server — Environment Variables

# Backend Base URL (e.g. http://localhost:5000)
JET_ADMIN_BACKEND_URL=http://localhost:5000

# Jet Admin API Key (Create in Settings → API Keys in Jet Admin dashboard)
JET_ADMIN_API_KEY=your_api_key_here

# Tenant ID (e.g. from URL /tenants/<tenantID>/...)
JET_ADMIN_TENANT_ID=your_tenant_id_here

# Optional configuration
JET_ADMIN_TIMEOUT=30000
DEBUG=false
