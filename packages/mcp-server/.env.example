# Jet Admin MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# ------------------------------------------------------------------
# REQUIRED: Your Jet Admin backend URL
# ------------------------------------------------------------------
JET_ADMIN_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------
# REQUIRED: Jet Admin API Key
# Create one in Jet Admin → Settings → API Keys
# The key must have sufficient permissions for the tools you want to use.
# Format: api_key <your_key_here>  (prefix is added automatically)
# ------------------------------------------------------------------
JET_ADMIN_API_KEY=your_api_key_here

# ------------------------------------------------------------------
# REQUIRED: Tenant ID to operate against
# Find this in the URL when you're inside a tenant: /tenants/<tenantID>/...
# ------------------------------------------------------------------
JET_ADMIN_TENANT_ID=your_tenant_id_here

# ------------------------------------------------------------------
# OPTIONAL: Request timeout in milliseconds (default: 30000)
# ------------------------------------------------------------------
JET_ADMIN_TIMEOUT=30000

# ------------------------------------------------------------------
# OPTIONAL: Retry configuration for transient failures
# JET_ADMIN_RETRIES     — max retry attempts on 5xx/network errors (default: 3, set 0 to disable)
# JET_ADMIN_RETRY_DELAY — base delay in ms for exponential backoff (default: 500)
# ------------------------------------------------------------------
# JET_ADMIN_RETRIES=3
# JET_ADMIN_RETRY_DELAY=500

# ------------------------------------------------------------------
# OPTIONAL: Debug logging — set to "true" to log all API calls to stderr
# MCP servers must NEVER write anything to stdout (it breaks the protocol).
# All logs go to stderr.
# ------------------------------------------------------------------
DEBUG=false

