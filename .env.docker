# ============================================
# Jet Admin - Docker Environment Variables
# ============================================
# Copy this file to .env and configure for your environment
# Usage: cp .env.docker .env
# (docker compose reads `.env` automatically for ${VAR} substitution)
#
# Only variables consumed by the code are listed here. Removed dead keys:
# JWT_ACCESS_TOKEN_SECRET / JWT_REFRESH_TOKEN_SECRET / ACCESS_TOKEN_TIMEOUT /
# REFRESH_TOKEN_TIMEOUT / SESSION_SECRET (auth is Firebase + API keys),
# RABBITMQ_* (nothing connects to RabbitMQ), GEMINI_API_KEY / NVIDIA_API_KEY
# (AI uses OPENROUTER_API_KEY or tenant vault keys), SSL_CERT_CN (no TLS in
# nginx), UNPOOLED_DATABASE_URL, JET_ADMIN_INTERNAL_API_KEY.
#
# Listener pipeline modes:
#   Embedded (local dev default): QUEUE_DRIVER=memory, LISTENER_INGRESS=embedded
#     — the backend subscribes + serves /webhooks itself, no Redis needed.
#   Proxy (compose default): QUEUE_DRIVER=redis, LISTENER_INGRESS=proxy,
#     REDIS_URL=redis://redis:6379 — the listener-proxy owns subscriptions +
#     webhooks and publishes to the Redis Stream; backends consume.
QUEUE_DRIVER=memory
LISTENER_INGRESS=embedded
# REDIS_URL=redis://localhost:6379  # local dev with Redis
LISTENER_PROXY_PORT=8095
# LISTENER_STREAM=listener:events
# LISTENER_GROUP=listener-workers
# LISTENER_DLQ_STREAM=listener:events:dlq
# LISTENER_CONTROL_CHANNEL=listener:control
# LISTENER_PREFETCH=20
# LISTENER_STREAM_MAXLEN=10000
# PROXY_CONTROL_TOKEN=  # optional shared secret for proxy control endpoint

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=8090
# Backend container port layout (see Dockerfile.backend + nginx.backend.conf):
# nginx listens on NGINX_PORT (compose: 3000, Render: $PORT) and proxies to
# Node.js on 127.0.0.1:NODE_PORT. The entrypoint adopts PORT as NGINX_PORT
# when NGINX_PORT is unset, then re-exports PORT=$NODE_PORT for Node.
# Compose overrides PORT/NGINX_PORT to 3000 — only change these for
# non-compose / Render-style runs.
# NGINX_PORT=8090
# NODE_PORT=3001
# CLIENT_MAX_BODY_SIZE=10m
# Public base URL of the backend (OAuth callbacks, AI referer header)
BACKEND_URL=http://localhost:8090

# ============================================
# Database Configuration
# ============================================
# Default: bundled `postgres` service (POSTGRES_* below), started by a full
# `up`. To use your OWN database instead, set DATABASE_URL to it and leave
# `postgres` out of your `up` service list — nothing depends on it, so it
# simply never starts (no override file needed).
# (`localhost` inside a container = the container itself; use
# host.docker.internal for a DB on your machine.)
# DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/jet_admin_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=jet_admin_db
# Host port for the bundled postgres (change on conflict)
POSTGRES_HOST_PORT=5432

# Set to true on first run to initialize database
SEED_DATABASE=false

# ============================================
# Required Secrets (generate with: openssl rand -hex 32)
# ============================================
# Encrypts datasource credentials + OAuth secrets at rest.
# NOTE: changing this after data exists makes stored credentials unreadable.
VAULT_ENCRYPTION_KEY=
# Signs OAuth `state` tokens (Google login). Required for Google sign-in.
OAUTH_STATE_SECRET=

# ============================================
# Google OAuth (optional — only for Google sign-in)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Firebase Admin (optional — only for Firebase token verification)
# ============================================
# FIREBASE_CREDENTIALS='<service-account-json>'

# ============================================
# Frontend -> Backend URL
# ============================================
# Baked into the frontend bundle at build time AND applied at container
# startup via /config.js (runtime value wins, no rebuild needed).
# For local compose keep http://localhost:8090. For cloud deploys
# set to your public backend URL, e.g. https://your-api.onrender.com
VITE_SERVER_HOST=http://localhost:8090
VITE_SOCKET_HOST=http://localhost:8090

# ============================================
# Firebase Configuration (Optional)
# ============================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ============================================
# S3-Compatible Object Storage (file uploads)
# ============================================
# One client (@aws-sdk/client-s3) talks to ANY backend: AWS S3, MinIO,
# or RustFS (bundled, `--profile storage`).
#
# --- Option A: bundled RustFS (self-hosted) ---
#   docker compose --profile storage up -d
# S3_ENDPOINT=http://rustfs:9000
# S3_ACCESS_KEY_ID must match RUSTFS_ACCESS_KEY (same for SECRET).
#
# --- Option B: AWS S3 ---
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
# Must match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY below when using the
# bundled RustFS (defaults align with the compose fallbacks — keep them
# in sync or uploads silently disable). Empty = S3 path disabled.
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=jet-admin-datasource-file-uploads
# Browser-facing base URL for public file links
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Bundled RustFS credentials (CHANGE before exposing!) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp4
SYSLOG_LEVEL=warning
LOG_RETENTION=7
LOG_FILE_SIZE=1

# ============================================
# AI Configuration (Optional — Jet Agent via OpenRouter)
# ============================================
# Tenants can also bring their own key in Tenant Settings → AI Configuration.
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=minimax/minimax-m3

# ============================================
# Modules Configuration
# ============================================
# Comma-separated backend modules (no spaces). Full set below; minimal
# local dev can be e.g. auth,tenant,database.
ENABLED_MODULES=auth,tenant,database,datasource,dataQuery,workflow,widget,dashboard,userManagement,role,apiKey,cronJob,audit,ai,notification,permission

# ============================================
# Temporal Configuration (unified compose)
# ============================================
# Backend + temporal-worker talk to the `temporal` service
# over the Docker network. For local dev outside Docker,
# use localhost:7233.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=jet-admin-workflows
TEMPORAL_WORKER_START_MAX_ATTEMPTS=0
TEMPORAL_WORKER_START_BASE_DELAY_MS=1000
TEMPORAL_WORKER_START_MAX_DELAY_MS=30000
TEMPORAL_WORKER_RESTART_ON_CRASH=true

# ============================================
# CORS Configuration
# ============================================
# Exact-match browser origins, comma separated (no spaces needed — trimmed).
# `http://localhost` = bundled frontend on port 80. Add public frontend
# origin(s) when self-hosting, e.g. https://app.example.com
CORS_WHITELIST=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ============================================
# Express Configuration
# ============================================
EXPRESS_REQUEST_SIZE_LIMIT=5mb

# ============================================
# MCP Server Configuration (AI agent tools — optional)
# ============================================
# Start with: docker compose --profile mcp up -d
# Endpoint: POST http://localhost:<MCP_HOST_PORT>/tenants/<tenantID>/mcp
#
# For Backend -> MCP communication: URL of the MCP container
# (as seen from INSIDE the docker network)
MCP_SERVER_URL=http://mcp-server:5001
# Container/host ports for the MCP server
MCP_PORT=5001
MCP_HOST_PORT=5001

# For MCP -> Backend communication: backend URL as seen from INSIDE the
# docker network (container port 3000, NOT the host-mapped 8090)
JET_ADMIN_BACKEND_URL=http://backend:3000
# Same Firebase credentials as backend (REQUIRED for MCP token verification —
# the mcp-server container exits without it)
# FIREBASE_CREDENTIALS='<service-account-json>'
# Set to "true" to enable verbose debug logging for MCP
MCP_DEBUG=false
